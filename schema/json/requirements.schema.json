  "type": "object",
  "properties": {
    "apiKey": {
      "type": "object",
      "properties": {
        "value": {
          "type": "object",
          "properties": {
            "need": {
              "type": "string",
              "enum": [
                "none",
                "optional",
                "required",
                "unknown"
              ]
            },
            "providers": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "e.g. ['OpenAI', 'Anthropic', 'Ollama (local)']"
            },
            "mode": {
              "type": "string",
              "enum": [
                "byok",
                "developer-hosted",
                "both",
                "not-applicable",
                "unknown"
              ]
            },
            "freeTier": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "const": "unknown"
                }
              ]
            }
          },
          "required": [
            "need",
            "providers",
            "mode",
            "freeTier"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "approved",
            "edited",
            "rejected"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "llm",
            "human",
            "analysis",
            "sheet"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "0 = guess, 1 = certain. LLM-reported confidence is capped when evidence fails verification."
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "text"
              },
              "source": {
                "type": "string",
                "enum": [
                  "readme",
                  "manifest",
                  "release-notes",
                  "sheet",
                  "disclosure",
                  "repo-metadata"
                ]
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "verbatim": {
                "type": "boolean",
                "description": "True when the quote was found verbatim (after whitespace normalisation) in the source we gave the model."
              }
            },
            "required": [
              "kind",
              "source",
              "quote",
              "verbatim"
            ]
          }
        }
      },
      "required": [
        "value",
        "status",
        "source",
        "confidence",
        "evidence"
      ]
    },
