{
  "$id": "https://github.com/iliasacademia/zoteroatlas/schema/json/ratings.schema.json",
  "title": "ratings",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "plugins": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "all": {
            "type": "object",
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "average": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 5
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "stars": {
                "minItems": 5,
                "maxItems": 5,
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "description": "How many 1-, 2-, 3-, 4- and 5-star ratings, in that order"
              }
            },
            "required": [
              "count",
              "average",
              "stars"
            ]
          },
          "versions": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "average": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 1,
                      "maximum": 5
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "stars": {
                  "minItems": 5,
                  "maxItems": 5,
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "description": "How many 1-, 2-, 3-, 4- and 5-star ratings, in that order"
                }
              },
              "required": [
                "count",
                "average",
                "stars"
              ]
            }
          },
          "reviews": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "stars": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "version": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "by": {
                  "type": "string",
                  "description": "\"Zotero Atlas user\", the name a website reviewer chose, or \"Anonymous\""
                },
                "from": {
                  "type": "string",
                  "enum": [
                    "zotero-atlas",
                    "website"
                  ]
                },
                "zotero": {
                  "description": "The Zotero version, for ratings from Zotero Atlas",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "usedDays": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "How long that install had the plugin when it rated, from its plugin lists"
                },
                "posted": {
                  "type": "string",
                  "description": "YYYY-MM-DD"
                }
              },
              "required": [
                "stars",
                "version",
                "text",
                "by",
                "from",
                "zotero",
                "usedDays",
                "posted"
              ]
            },
            "description": "Reviews with text, newest first"
          }
        },
        "required": [
          "all",
          "versions",
          "reviews"
        ]
      },
      "description": "By the plugin's slug"
    }
  },
  "required": [
    "generatedAt",
    "plugins"
  ]
}
