{
  "$id": "https://github.com/iliasacademia/zoteroatlas/schema/json/advisories.schema.json",
  "title": "advisories",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "advisories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ZPA-\\d{4}-\\d{3}$",
            "description": "ZPA-<year>-<number>, never reused"
          },
          "addon": {
            "type": "string",
            "minLength": 1,
            "description": "The add-on ID Zotero knows the plugin by"
          },
          "slug": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 2,
                "maxLength": 100,
                "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
              },
              {
                "type": "null"
              }
            ],
            "description": "Its page on zoteroplugins.org, when it's listed"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "affects": {
            "type": "object",
            "properties": {
              "min": {
                "description": "The first affected version, or null for all before max",
                "type": [
                  "string",
                  "null"
                ]
              },
              "max": {
                "description": "The last affected version, or null for every later one",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "min",
              "max"
            ],
            "description": "Inclusive, compared the way Zotero compares versions"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "important"
            ],
            "description": "critical: a bar above the library until dealt with; important: one notice and the red dot"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "One line: what's wrong, e.g. 'uploads your library'"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "What happens and what to do, in a sentence or two"
          },
          "fixedIn": {
            "description": "The first version without the problem, if any",
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Where to read more: the plugin's card, or the developer's notice"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "id",
          "addon",
          "slug",
          "name",
          "affects",
          "severity",
          "title",
          "text",
          "fixedIn",
          "url",
          "publishedAt"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "updatedAt",
    "advisories"
  ]
}
