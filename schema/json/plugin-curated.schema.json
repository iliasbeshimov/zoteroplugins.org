                "approved",
                "edited",
                "rejected"
              ]
            },
            "source": {
              "type": "string",
              "enum": [
                "llm",
                "human",
                "analysis",
                "sheet"
              ]
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "0 = guess, 1 = certain. LLM-reported confidence is capped when evidence fails verification."
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "text"
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "readme",
                      "manifest",
                      "release-notes",
                      "sheet",
                      "disclosure",
                      "repo-metadata"
