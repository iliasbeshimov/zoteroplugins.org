              "analytics"
            ]
          }
        }
      },
      "required": [
        "primary"
      ]
    },
    "alternatives": {
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
          },
          "difference": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "slug",
          "difference"
        ]
      }
    },
    "starterPacks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$",
        "description": "Key into data/starter-packs.yaml"
      }
    },
    "notices": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "legal-risk",
              "developer-reply",
              "correction",
              "info"
            ]
          },
          "text": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "kind",
          "text",
          "date"
        ]
      }
    },
    "reviews": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reviewer": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "github": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          },
          "reviewedAt": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "analysisSha256": {
            "description": "SHA-256 of the analysis document the reviewer saw.",
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "fields": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "description": "Dotted field path, e.g. 'requirements.apiKey' or 'content.oneLiner'"
                },
                "decision": {
                  "type": "string",
                  "enum": [
                    "approved",
                    "edited",
                    "rejected"
                  ]
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "decision"
              ]
            }
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "reviewer",
          "reviewedAt",
          "version",
          "fields"
        ]
      }
    },
    "responses": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "description": "GitHub login of a maintainer of the plugin's repository"
          },
          "about": {
            "type": "string",
            "enum": [
              "source-transparency",
              "data-sharing",
              "capabilities",
              "compatibility",
              "updates",
              "other"
            ]
          },
          "version": {
            "description": "The version the response is about",
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "The developer's words, published as written"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The public issue it came from"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "corrected",
              "finding-stands",
              "noted"
            ],
            "description": "open: we're checking; corrected: the analyzer or rules changed and the card with them; finding-stands: we kept the finding (see reply); noted: context, not a dispute"
          },
          "reply": {
            "description": "What we checked and what changed, if anything",
            "type": "string",
            "maxLength": 2000
          },
          "repliedAt": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          }
        },
        "required": [
          "date",
          "from",
          "about",
          "text",
          "url",
          "status"
        ]
      }
    },
    "internalNotes": {
      "description": "Not published.",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "slug",
    "repo",
    "status"
  ]
}
