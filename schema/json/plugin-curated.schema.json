  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "slug": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "repo": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\/[a-z0-9._-]+$",
      "description": "Canonical GitHub repository key: lowercase owner/name"
    },
    "previousSlugs": {
      "default": [],
      "description": "Old URLs that should redirect here.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 100,
        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "listed",
        "candidate",
        "excluded"
      ]
    },
    "exclusion": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "not-a-plugin",
            "duplicate",
            "no-source-repo",
            "spam",
            "requested-by-developer",
            "other"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "reason"
      ]
    },
