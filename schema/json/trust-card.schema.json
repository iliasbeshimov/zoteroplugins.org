{
  "$id": "https://github.com/iliasacademia/zoteroatlas/schema/json/trust-card.schema.json",
  "title": "trust-card",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "rulesVersion": {
      "type": "string"
    },
    "computedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "appliesTo": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "slug",
        "version",
        "sha256"
      ]
    },
    "inputs": {
      "type": "object",
      "properties": {
        "analyzerVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenanceCheckerVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "hostsTableVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "currentZotero": {
          "type": "string"
        },
        "inputHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Hash of every input above; unchanged hash means unchanged card"
        }
      },
      "required": [
        "analyzerVersion",
        "provenanceCheckerVersion",
        "hostsTableVersion",
        "currentZotero",
        "inputHash"
      ]
    },
    "facets": {
      "type": "object",
      "properties": {
        "sourceTransparency": {
          "type": "object",
          "properties": {
            "provenance": {
              "type": "string",
              "enum": [
                "reproduced",
                "matches-source",
                "plausible",
                "mismatch",
                "no-source",
                "not-checked"
              ]
            },
            "obfuscated": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string",
                  "const": "unknown"
                }
              ]
            },
            "suspiciousUnicode": {
              "type": "boolean"
            },
            "sourceMaps": {
              "type": "boolean"
            },
            "assetReplaced": {
              "type": "boolean",
              "description": "The file behind this release tag changed after it was first published"
            },
            "assetReplacedDetail": {
              "description": "How we know it changed: our own earlier copy, or the fingerprint the project's own update manifest gives for this version",
              "type": "string"
            },
            "updates": {
              "description": "Where updates come from; a template namespace the developer doesn't control is a concern",
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "check": {
                  "description": "What the update address offers today, e.g. a different file and its label",
                  "type": "string"
                },
                "note": {
                  "description": "What the plugin does to its own updates, e.g. turning Zotero's automatic updates on",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "label"
              ]
            },
            "partialAnalysis": {
              "description": "Set when part of the code was skipped or only scanned for known patterns",
              "type": [
                "string",
                "null"
              ]
            },
            "concern": {
              "type": "string",
              "enum": [
                "none",
                "low",
                "medium",
                "high",
                "unknown"
              ]
            },
            "label": {
              "type": "string"
            },
            "drivers": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "IDs of the rules that fired (the rule table in pipeline/src/profile/score.ts)"
            }
          },
          "required": [
            "provenance",
            "obfuscated",
            "suspiciousUnicode",
            "sourceMaps",
            "assetReplaced",
            "concern",
            "label",
            "drivers"
          ]
        },
        "dataSharing": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "no-network-found",
                "user-configured-only",
                "named-third-parties",
                "developer-servers",
                "unknown-endpoints",
                "bundled-library-only",
                "not-analyzed"
              ]
            },
            "hosts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "category": {
                    "type": "string",
                    "enum": [
                      "llm-provider",
                      "translation",
                      "scholarly-api",
                      "zotero",
                      "code-hosting",
                      "integration",
                      "telemetry",
                      "cloud-function",
                      "developer-server",
                      "localhost",
                      "cdn",
                      "documentation",
                      "unknown"
                    ]
                  },
                  "hosts": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "unconfirmed": {
                    "description": "Hosts in this group we found in the code but didn't trace to a request (shown as 'named in its code')",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "unencrypted": {
                    "description": "Hosts in this group a request reaches over plain http:// (shown as 'unencrypted'): anyone on the network in between can read or change what's sent",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "observed": {
                    "description": "Hosts in this group the plugin contacted when we ran this exact file in Zotero (shown as 'seen when we ran it'), whether or not we found them in its code; they count as traced requests",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "category",
                  "hosts"
                ]
              }
            },
            "concern": {
              "type": "string",
              "enum": [
                "none",
                "low",
                "medium",
                "high",
                "unknown"
              ]
            },
            "label": {
              "type": "string"
            },
            "legalRisk": {
              "description": "A destination is a shadow library such as Sci-Hub: shown as a neutral legal notice",
              "type": "boolean"
            },
            "drivers": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "IDs of the rules that fired (the rule table in pipeline/src/profile/score.ts)"
            }
          },
          "required": [
            "value",
            "hosts",
            "concern",
            "label",
            "drivers"
          ]
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "badges": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "enum": [
                      "filesystem",
                      "process-launch",
                      "native-code",
                      "db-write",
                      "sqlite-direct",
                      "remote-code",
                      "dynamic-code",
                      "credential-storage",
                      "login-manager",
                      "clipboard",
                      "local-http-server",
                      "network-intercept",
                      "ui-injection",
                      "self-update",
                      "remote-script",
                      "remote-script-output",
                      "installs-addons",
                      "download-exec",
                      "borrowed-identity",
                      "encrypted-code",
                      "link-runs-code",
                      "link-installs-addons",
                      "disables-security",
                      "own-server",
                      "self-installs",
                      "runs-bundled-binary",
                      "package-run",
                      "installs-translators",
                      "own-database",
                      "runs-sent-code",
                      "enables-local-api",
                      "server-edits-library",
                      "browser-credentials",
                      "reused-app-login",
                      "changes-settings",
                      "sends-unencrypted"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "description": "Plain language, e.g. 'Writes to the Zotero database directly'"
                  },
                  "concern": {
                    "type": "string",
                    "enum": [
                      "none",
                      "low",
                      "medium",
                      "high",
                      "unknown"
                    ]
                  },
                  "libraries": {
                    "description": "Set when every use sits in bundled libraries: the card names them, e.g. 'from zotero-plugin-toolkit'",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "detail": {
                    "description": "What, where from or which setting, e.g. 'From astral.sh; not checked against a fixed fingerprint'",
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "label",
                  "concern"
                ]
              }
            },
            "concern": {
              "type": "string",
              "enum": [
                "none",
                "low",
                "medium",
                "high",
                "unknown"
              ]
            },
            "drivers": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "IDs of the rules that fired (the rule table in pipeline/src/profile/score.ts)"
            }
          },
          "required": [
            "badges",
            "concern",
            "drivers"
          ]
        },
        "requirements": {
          "type": "object",
          "properties": {
            "badges": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "enum": [
                      "api-key",
                      "account",
                      "paid",
                      "companion-app"
                    ]
                  },
                  "label": {
                    "type": "string"
                  },
                  "detail": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "label"
                ]
              }
            },
            "reviewed": {
              "type": "boolean",
              "description": "False while any requirement is still an unreviewed draft"
            }
          },
          "required": [
            "badges",
            "reviewed"
          ]
        },
        "maintenance": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "active",
                "slowing",
                "dormant",
                "archived"
              ]
            },
            "lastReleaseAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "lastCommitAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "concern": {
              "type": "string",
              "enum": [
                "none",
                "low",
                "medium",
                "high",
                "unknown"
              ]
            }
          },
          "required": [
            "status",
            "lastReleaseAt",
            "lastCommitAt",
            "concern"
          ]
        },
        "compatibility": {
          "type": "object",
          "properties": {
            "current": {
              "type": "object",
              "properties": {
                "zoteroVersion": {
                  "type": "string",
                  "description": "e.g. '10.0.3' or '11.0-dev.5'"
                },
                "major": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "compatible",
                    "incompatible",
                    "unknown"
                  ],
                  "description": "Whether Zotero at exactly zoteroVersion installs and runs it: every part of the version is compared, as Zotero does"
                }
              },
              "required": [
                "zoteroVersion",
                "major",
                "status"
              ]
            },
            "previous": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "zoteroVersion": {
                      "type": "string",
                      "description": "e.g. '10.0.3' or '11.0-dev.5'"
                    },
                    "major": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "compatible",
                        "incompatible",
                        "unknown"
                      ],
                      "description": "Whether Zotero at exactly zoteroVersion installs and runs it: every part of the version is compared, as Zotero does"
                    }
                  },
                  "required": [
                    "zoteroVersion",
                    "major",
                    "status"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "next": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "zoteroVersion": {
                      "type": "string",
                      "description": "e.g. '10.0.3' or '11.0-dev.5'"
                    },
                    "major": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "compatible",
                        "incompatible",
                        "unknown"
                      ],
                      "description": "Whether Zotero at exactly zoteroVersion installs and runs it: every part of the version is compared, as Zotero does"
                    }
                  },
                  "required": [
                    "zoteroVersion",
                    "major",
                    "status"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Next major on the beta/dev channel, if any"
            },
            "blockedByZotero": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "reason": {
                      "type": "string"
                    },
                    "source": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": [
                    "reason",
                    "source"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "This version is on Zotero's official plugin blocklist"
            },
            "installProblem": {
              "description": "Zotero won't install this manifest.json file at all, so it works with no Zotero version: an add-on ID missing or not in the form Firefox accepts (a GUID in braces, or name@domain in letters, digits, - . _), no update address (applications.zotero.update_url) or no maximum version (strict_max_version)",
              "type": "string",
              "enum": [
                "invalid-id",
                "no-update-url",
                "no-max-version"
              ]
            },
            "label": {
              "description": "One line shown next to the overall label: whether it runs on current Zotero",
              "type": "string"
            },
            "concern": {
              "type": "string",
              "enum": [
                "none",
                "low",
                "medium",
                "high",
                "unknown"
              ]
            }
          },
          "required": [
            "current",
            "previous",
            "next",
            "blockedByZotero",
            "concern"
          ]
        },
        "reviewStatus": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "automated-only",
                "human-reviewed"
              ]
            },
            "reviewer": {
              "type": "string"
            },
            "reviewedAt": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            "reviewedVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "stale": {
              "type": "boolean",
              "description": "A newer version with material changes has appeared since the review"
            }
          },
          "required": [
            "state",
            "stale"
          ]
        }
      },
      "required": [
        "sourceTransparency",
        "dataSharing",
        "capabilities",
        "requirements",
        "maintenance",
        "compatibility",
        "reviewStatus"
      ]
    },
    "overall": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "enum": [
            "low-concern",
            "review-details",
            "high-concern",
            "insufficient-data"
          ]
        },
        "ruleId": {
          "type": "string"
        },
        "drivers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "sourceTransparency",
              "dataSharing",
              "capabilities",
              "requirements",
              "maintenance",
              "compatibility",
              "reviewStatus"
            ]
          },
          "description": "Facets that determined the label, shown next to it"
        },
        "reasons": {
          "description": "The findings that set the label, most important first: the 'because' line",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "label",
        "ruleId",
        "drivers"
      ]
    },
    "tested": {
      "description": "What this exact file did when we ran it in a throwaway Zotero (data/sandbox/<slug>.json); absent when this file hasn't been tested",
      "type": "object",
      "properties": {
        "zotero": {
          "type": "string",
          "description": "The Zotero version it ran in"
        },
        "testedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "as-described",
            "unexpected",
            "not-loaded",
            "incomplete"
          ],
          "description": "as-described: it loaded, and everything it did beyond what Zotero does by itself is something its card says; unexpected: something it did isn't (the reasons are listed); not-loaded: it didn't start; incomplete: the test didn't finish"
        },
        "exercised": {
          "type": "object",
          "properties": {
            "itemsSelected": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "readerOpened": {
              "type": "boolean",
              "description": "A PDF was opened in Zotero's reader"
            },
            "settingsPane": {
              "type": "boolean",
              "description": "Zotero's settings opened at the plugin's own pane"
            },
            "menuItems": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Menu items the plugin added that the test clicked"
            },
            "dialogs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Dialogs and prompts the test answered"
            }
          },
          "required": [
            "itemsSelected",
            "readerOpened",
            "settingsPane",
            "menuItems",
            "dialogs"
          ],
          "description": "How much of the plugin the test reached"
        },
        "contacted": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Hosts it contacted during the test"
        },
        "sentTo": {
          "description": "Hosts that received the test library's own text during the test, and which kinds, e.g. api.crossref.org: identifiers, titles (the items' DOIs and titles); absent when none did, or when the record doesn't say",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": {
                "type": "string"
              },
              "sent": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "titles",
                    "identifiers",
                    "authors",
                    "abstract",
                    "notes",
                    "pdf-text",
                    "pdf-file",
                    "tags",
                    "collections"
                  ],
                  "description": "A kind of the test library's own text found in a request: its items' titles, identifiers (DOI, ISBN), authors, abstract, note, the PDF's text, the PDF file itself, tags or collection name"
                }
              }
            },
            "required": [
              "host",
              "sent"
            ]
          }
        },
        "fetched": {
          "description": "Hosts it only loaded pages from during the test (plain GET or HEAD requests, nothing sent): listed, but not counted as data sharing; absent when there were none, or when the record doesn't say",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unexpected": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "What it did that its card didn't say before the test, in plain English"
        }
      },
      "required": [
        "zotero",
        "testedAt",
        "verdict",
        "exercised",
        "contacted",
        "unexpected"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "rulesVersion",
    "computedAt",
    "appliesTo",
    "inputs",
    "facets",
    "overall"
  ]
}
