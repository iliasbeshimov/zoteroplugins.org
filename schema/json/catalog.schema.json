{
  "$id": "https://github.com/iliasacademia/zoteroatlas/schema/json/catalog.schema.json",
  "title": "catalog",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "currentZotero": {
      "type": "string",
      "description": "The Zotero version the grades and 'current' were computed for"
    },
    "rulesVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "site": {
      "type": "string",
      "format": "uri"
    },
    "shelves": {
      "description": "The site's home-page shelves. Absent in catalogues written before Atlas 1.3",
      "type": "object",
      "properties": {
        "picks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string",
                "minLength": 2,
                "maxLength": 100,
                "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
              },
              "shot": {
                "type": "string",
                "pattern": "^shots\\/[a-z0-9-]+\\.(jpg|png)$",
                "description": "The screenshot's path under site/public in the repository"
              },
              "w": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "h": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "alt": {
                "type": "string"
              }
            },
            "required": [
              "slug",
              "shot",
              "w",
              "h",
              "alt"
            ]
          },
          "description": "Chosen by hand, in order; a reader is shown the first few that fit"
        },
        "rising": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string",
                "minLength": 2,
                "maxLength": 100,
                "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
              },
              "stars": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "slug",
              "stars"
            ]
          },
          "description": "Most new GitHub stars in the last six weeks, among plugins whose downloads grew too"
        },
        "new": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string",
                "minLength": 2,
                "maxLength": 100,
                "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
              },
              "since": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            },
            "required": [
              "slug",
              "since"
            ]
          },
          "description": "Repositories created in the last 90 days, B or better, most used first"
        },
        "packs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string",
                "minLength": 2,
                "maxLength": 100,
                "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
              },
              "name": {
                "type": "string"
              },
              "who": {
                "type": "string"
              },
              "lead": {
                "type": "string"
              },
              "picks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "task": {
                      "type": "string"
                    },
                    "why": {
                      "type": "string"
                    },
                    "ifYou": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "plugins": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 2,
                        "maxLength": 100,
                        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
                      },
                      "description": "The plugin for the task, then fallbacks; listed slugs only"
                    },
                    "or": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "ifYou": {
                              "type": "string"
                            },
                            "why": {
                              "type": "string"
                            },
                            "plugins": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 2,
                                "maxLength": 100,
                                "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
                              }
                            }
                          },
                          "required": [
                            "ifYou",
                            "why",
                            "plugins"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "A plugin for readers who work differently"
                    }
                  },
                  "required": [
                    "task",
                    "why",
                    "ifYou",
                    "plugins",
                    "or"
                  ]
                }
              }
            },
            "required": [
              "slug",
              "name",
              "who",
              "lead",
              "picks"
            ]
          }
        }
      },
      "required": [
        "picks",
        "rising",
        "new",
        "packs"
      ]
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
          },
          "name": {
            "type": "string"
          },
          "id": {
            "description": "The add-on ID Zotero knows the plugin by",
            "type": [
              "string",
              "null"
            ]
          },
          "repo": {
            "type": "string",
            "format": "uri"
          },
          "page": {
            "type": "string",
            "format": "uri",
            "description": "The plugin's page on the site, with the full card"
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "jobs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The site's job slugs (reading, citing, ai, …), main job first, as the site lists them"
          },
          "grade": {
            "type": "string",
            "enum": [
              "A+",
              "A",
              "B",
              "C",
              "–"
            ]
          },
          "because": {
            "type": "string",
            "description": "The card's 'because …' line, without 'because'"
          },
          "version": {
            "type": "string"
          },
          "publishedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "supports": {
            "type": "array",
            "items": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "description": "Zotero majors the release works with; empty when Zotero won't install it"
          },
          "current": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "zotero": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "compatible",
                      "incompatible",
                      "unknown"
                    ]
                  }
                },
                "required": [
                  "zotero",
                  "status"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "Whether the Zotero version current when the catalogue was written installs and runs it"
          },
          "file": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "The release file's name"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "description": "The GitHub release asset"
                  },
                  "sha256": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The file we analysed; the plugin installs only a file with this hash"
                  },
                  "supports": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "description": "Zotero majors its range covers, as Zotero applies it (its update file included)"
                  },
                  "min": {
                    "description": "strict_min_version, compared the way Zotero does; its update file's when that raised the range",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "max": {
                    "description": "strict_max_version, or the higher one its update file's entry for this version gives (Zotero applies it on install)",
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "name",
                  "url",
                  "sha256",
                  "supports",
                  "min",
                  "max"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "The build current Zotero installs"
          },
          "builds": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The release file's name"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "description": "The GitHub release asset"
                },
                "sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The file we analysed; the plugin installs only a file with this hash"
                },
                "supports": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "description": "Zotero majors its range covers, as Zotero applies it (its update file included)"
                },
                "min": {
                  "description": "strict_min_version, compared the way Zotero does; its update file's when that raised the range",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "max": {
                  "description": "strict_max_version, or the higher one its update file's entry for this version gives (Zotero applies it on install)",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "name",
                "url",
                "sha256",
                "supports",
                "min",
                "max"
              ]
            },
            "description": "The release's other builds, e.g. for an older Zotero"
          },
          "update": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "version": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "grade": {
                    "type": "string",
                    "enum": [
                      "A+",
                      "A",
                      "B",
                      "C",
                      "–"
                    ]
                  },
                  "sha256": {
                    "description": "That file's SHA-256 once downloaded; absent in catalogues written before Atlas 1.0",
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "version",
                  "grade"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "What the plugin's own update address offers today, when it's a different file from this one"
          },
          "blocked": {
            "description": "Why Zotero's official blocklist blocks this version",
            "type": [
              "string",
              "null"
            ]
          },
          "tested": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "zotero": {
                    "type": "string"
                  },
                  "verdict": {
                    "type": "string"
                  }
                },
                "required": [
                  "zotero",
                  "verdict"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "Our live test of this exact file"
          },
          "needs": {
            "type": "object",
            "properties": {
              "apiKey": {
                "type": "string",
                "enum": [
                  "none",
                  "optional",
                  "required",
                  "unknown"
                ]
              },
              "services": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "AI services it can use"
              },
              "localModel": {
                "type": "boolean",
                "description": "Can use a model on this computer"
              },
              "launchesPrograms": {
                "type": "boolean"
              }
            },
            "required": [
              "apiKey",
              "services",
              "localModel",
              "launchesPrograms"
            ]
          },
          "downloads": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "stars": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "maintenance": {
            "type": "string"
          },
          "lastReleaseAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "docsChineseOnly": {
            "type": "boolean"
          },
          "previous": {
            "description": "Up to three earlier releases we analysed, newest first: what Atlas can go back to, and the grade an update is compared with. Absent in catalogues written before Atlas 1.0",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "version": {
                  "type": "string"
                },
                "grade": {
                  "type": "string",
                  "enum": [
                    "A+",
                    "A",
                    "B",
                    "C",
                    "–"
                  ],
                  "description": "Its grade when we checked it (A at most: live tests are of the listed version)"
                },
                "file": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "The release file's name"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri",
                      "description": "The GitHub release asset"
                    },
                    "sha256": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "The file we analysed; the plugin installs only a file with this hash"
                    },
                    "supports": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      },
                      "description": "Zotero majors its range covers, as Zotero applies it (its update file included)"
                    },
                    "min": {
                      "description": "strict_min_version, compared the way Zotero does; its update file's when that raised the range",
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "max": {
                      "description": "strict_max_version, or the higher one its update file's entry for this version gives (Zotero applies it on install)",
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "url",
                    "sha256",
                    "supports",
                    "min",
                    "max"
                  ]
                }
              },
              "required": [
                "version",
                "grade",
                "file"
              ]
            }
          },
          "ratings": {
            "description": "Published ratings from Zotero Atlas and zoteroplugins.org; never part of the grade. Absent in catalogues written before ratings",
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "Published ratings of every version"
                  },
                  "average": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "version": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "count": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "average": {
                            "type": [
                              "number",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "count",
                          "average"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Ratings of the version listed here"
                  }
                },
                "required": [
                  "count",
                  "average",
                  "version"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "line": {
            "description": "One line for lists: the site's tagline, or the summary's first sentence. Absent in catalogues written before Atlas 1.3",
            "type": "string"
          },
          "icon": {
            "description": "The plugin's own icon is in the repository at site/public/icons/<slug>.png (96 px). Absent in catalogues written before Atlas 1.3",
            "type": "boolean"
          },
          "inUse": {
            "description": "About how many copies of Zotero have it, estimated from the census history like the site's 'in use'. Absent in catalogues written before Atlas 1.3",
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "ask": {
            "description": "How people ask for it, in the words they type into a search box (data/search/phrases.json), for search. Absent when none are written, and in catalogues written before Atlas 1.3.1",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "slug",
          "name",
          "id",
          "repo",
          "page",
          "summary",
          "jobs",
          "grade",
          "because",
          "version",
          "publishedAt",
          "supports",
          "current",
          "file",
          "builds",
          "update",
          "blocked",
          "tested",
          "needs",
          "downloads",
          "stars",
          "maintenance",
          "lastReleaseAt",
          "docsChineseOnly"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "currentZotero",
    "rulesVersion",
    "site",
    "plugins"
  ]
}
