# Copy to .env and fill in. Never commit .env.

# GitHub API token (read-only public repo access is enough).
# Fine-grained PAT with "Public repositories (read-only)" or a classic token with no scopes.
GITHUB_TOKEN=

# Anthropic API key, needed only for `atlas enrich` (Milestone 3).
ANTHROPIC_API_KEY=

# Optional overrides
# ATLAS_LLM_MODEL=claude-sonnet-5
# ATLAS_CACHE_DIR=.cache
# ATLAS_USER_AGENT=zotero-plugin-atlas (+https://github.com/iliasacademia/zoteroatlas)
