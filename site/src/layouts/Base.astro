---
import "../styles/global.css";
import JsonLd from "../components/JsonLd.astro";

interface Props {
  title: string;
  description: string;
  /** Keep this page out of search indexes (it stays reachable and its links are still followed). */
  noindex?: boolean;
  /** Structured data for the page (see lib/meta.ts). */
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
  /** Open Graph type: "website" for most pages, "article" for guides. */
  ogType?: "website" | "article";
}

const { title, description, jsonld, ogType = "website" } = Astro.props;
// Pages are built as files (p/x.html) but served without the extension (/p/x), so the canonical
// address drops ".html" and "index".
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/(^|\/)index$/, "$1") || "/";
const notFound = path === "/404";
const canonical = new URL(path, Astro.site);
// Per-plugin developer checklists, shared-ID pages and the compare tool repeat what the plugin
// pages say, so search engines get the plugin pages instead.
const noindex =
  Astro.props.noindex || notFound || /^\/(developers|id)\/./.test(path) || path === "/compare";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="application/rss+xml" title="Grade log" href="/log.xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!notFound && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:site_name" content="Zotero Plugins Atlas" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!notFound && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Zotero Plugins Atlas: every Zotero plugin, checked before you install" />
    <meta property="og:locale" content="en" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonld && <JsonLd data={jsonld} />}
  </head>
  <body class="min-h-screen antialiased">
    <slot />
    <script>
      // Keep an open tooltip inside the window: shift it sideways if it would spill over an edge.
      const fit = (e: Event) => {
        const tt = (e.target as Element | null)?.closest?.(".tip")?.querySelector<HTMLElement>(":scope > .tt");
        if (!tt) return;
        // Hover and focus styles apply a frame later on touch screens, so measure after two frames.
        // The shift is worked out from the unshifted position, so running twice gives the same result.
        requestAnimationFrame(() =>
          requestAnimationFrame(() => {
            const r = tt.getBoundingClientRect();
            if (!r.width) return;
            const cur = Number.parseFloat(tt.style.getPropertyValue("--dx")) || 0;
            const left = r.left - cur;
            const right = r.right - cur;
            const dx = left < 8 ? 8 - left : right > innerWidth - 8 ? innerWidth - 8 - right : 0;
            tt.style.setProperty("--dx", `${dx}px`);
          }),
        );
      };
      document.addEventListener("mouseover", fit);
      document.addEventListener("focusin", fit);
    </script>
  </body>
</html>
