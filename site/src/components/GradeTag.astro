---
/** The Atlas grade: an arrow tag (A+ A B C, a dashed box for "not graded"), the ladder, or the README badge. */
interface Props {
  grade: string;
  variant?: "tag" | "ladder" | "readme";
  size?: "xs" | "sm" | "md" | "lg" | "xl";
  brand?: string;
}
const { grade: raw, variant = "tag", size = "sm", brand = "Zotero Plugins" } = Astro.props;
const TOK: Record<string, string> = { "A+": "ap", A: "a", B: "b", C: "c" };
const WORD: Record<string, string> = { "A+": "Recommended, tested in Zotero", A: "Recommended", B: "Use with care", C: "Not recommended", "–": "Not graded yet" };
const SIZES = ["xs", "sm", "md", "lg", "xl"];
const LAD: Record<string, [number, number, number, number, number]> = { xs: [18, 11, 48, 3, 6], sm: [18, 11, 48, 3, 6], md: [28, 14, 80, 5, 8], lg: [38, 19, 120, 6, 10], xl: [38, 19, 120, 6, 10] };
const arrowR = (n: number) => `polygon(0 0,calc(100% - ${n}px) 0,100% 50%,calc(100% - ${n}px) 100%,0 100%)`;
const arrowL = (n: number) => `polygon(${n}px 0,100% 0,100% 100%,${n}px 100%,0 50%)`;
const grade = TOK[raw] ? raw : "–";
const t = TOK[grade];
const none = !t;
const aria = none ? "Atlas grade: not graded yet" : `Atlas grade ${grade}: ${WORD[grade]}`;
// The tag's size and colour are classes (gs-<size>, gt-<grade>, defined below) rather than an
// inline style, since lists render one tag per card.
const sizeClass = `gs-${SIZES.includes(size) ? size : "sm"}`;
const [lh, lfs, w0, gap, ln] = LAD[size] ?? LAD.md;
const rungs = ["A+", "A", "B", "C"].map((g, i) => ({
  g,
  style: `height:${lh}px;width:${Math.round(w0 * (1 + i / 3))}px;padding-left:${Math.round(lh * 0.32)}px;background:var(--g-${TOK[g]});color:var(--g-${TOK[g]}-on);font-size:${lfs}px;clip-path:${arrowR(ln)}`,
  cur: g === grade,
}));
const pointer = `height:${lh + 6}px;padding:0 ${Math.round(lh * 0.4)}px 0 ${ln + 10}px;font-size:${lfs + 4}px;clip-path:${arrowL(ln + 2)}`;
---

{
  variant === "tag" && (
    <span role="img" aria-label={aria} class:list={["tag", sizeClass, none ? "none" : `gt-${t}`]}>
      {none ? "–" : grade}
    </span>
  )
}
{
  variant === "ladder" && (
    <div role="img" aria-label={aria} class="ladder" style={`gap:${gap}px ${gap + 4}px`}>
      {rungs.map((r) => (
        <>
          <span class="rung" style={r.style}>{r.g}</span>
          <span class="slot" style={`min-width:${Math.round(lh * 1.6)}px`}>
            {r.cur && <span class="pointer" style={pointer}>{r.g}</span>}
          </span>
        </>
      ))}
    </div>
  )
}
{
  variant === "readme" && (
    <span role="img" aria-label={aria} class="readme">
      <span class="brand">{brand}</span>
      <span class="g" style={none ? "background:var(--nd-fg);color:var(--surface)" : `background:var(--g-${t});color:var(--g-${t}-on)`}>{grade}</span>
    </span>
  )
}

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    flex: none;
    font-family: var(--font-sans);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .tag.none {
    border: 1.5px dashed var(--nd-line);
    color: var(--nd-fg);
  }
  /* Sizes: height, font size and arrow depth (xs 20/12/7, sm 26/14/9, md 34/17/11, lg 48/24/14,
     xl 72/38/20); at least 1.55× the height wide (1.3× when not graded), padded 0.3× the height,
     plus the arrow on the right. */
  .tag.gs-xs {
    height: 20px;
    min-width: 31px;
    padding: 0 13px 0 6px;
    font-size: 12px;
    clip-path: polygon(0 0, calc(100% - 7px) 0, 100% 50%, calc(100% - 7px) 100%, 0 100%);
  }
  .tag.none.gs-xs {
    min-width: 26px;
    padding: 0 6px;
    clip-path: none;
  }
  .tag.gs-sm {
    height: 26px;
    min-width: 40px;
    padding: 0 17px 0 8px;
    font-size: 14px;
    clip-path: polygon(0 0, calc(100% - 9px) 0, 100% 50%, calc(100% - 9px) 100%, 0 100%);
  }
  .tag.none.gs-sm {
    min-width: 34px;
    padding: 0 8px;
    clip-path: none;
  }
  .tag.gs-md {
    height: 34px;
    min-width: 53px;
    padding: 0 21px 0 10px;
    font-size: 17px;
    clip-path: polygon(0 0, calc(100% - 11px) 0, 100% 50%, calc(100% - 11px) 100%, 0 100%);
  }
  .tag.none.gs-md {
    min-width: 44px;
    padding: 0 10px;
    clip-path: none;
  }
  .tag.gs-lg {
    height: 48px;
    min-width: 74px;
    padding: 0 28px 0 14px;
    font-size: 24px;
    clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 50%, calc(100% - 14px) 100%, 0 100%);
  }
  .tag.none.gs-lg {
    min-width: 62px;
    padding: 0 14px;
    clip-path: none;
  }
  .tag.gs-xl {
    height: 72px;
    min-width: 112px;
    padding: 0 42px 0 22px;
    font-size: 38px;
    clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 50%, calc(100% - 20px) 100%, 0 100%);
  }
  .tag.none.gs-xl {
    min-width: 94px;
    padding: 0 22px;
    clip-path: none;
  }
  .tag.gt-ap {
    background: var(--g-ap);
    color: var(--g-ap-on);
  }
  .tag.gt-a {
    background: var(--g-a);
    color: var(--g-a-on);
  }
  .tag.gt-b {
    background: var(--g-b);
    color: var(--g-b-on);
  }
  .tag.gt-c {
    background: var(--g-c);
    color: var(--g-c-on);
  }
  .ladder {
    display: inline-grid;
    grid-template-columns: auto auto;
    align-items: center;
  }
  .rung,
  .pointer {
    display: flex;
    align-items: center;
    box-sizing: border-box;
    font-family: var(--font-sans);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .slot {
    display: flex;
  }
  .pointer {
    background: var(--ink);
    color: var(--surface);
  }
  .readme {
    display: inline-flex;
    height: 22px;
    border-radius: 5px;
    overflow: hidden;
    white-space: nowrap;
    font: 650 12px/1 var(--font-sans);
  }
  .readme .brand {
    display: flex;
    align-items: center;
    padding: 0 8px;
    background: var(--accent);
    color: var(--accent-ink);
  }
  .readme .g {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 9px;
    min-width: 30px;
    font-weight: 800;
  }
</style>
