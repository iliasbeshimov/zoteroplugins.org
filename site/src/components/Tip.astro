---
/**
 * A label with an explanation that shows on hover, keyboard focus or tap. The explanation is
 * linked with aria-describedby, so screen readers read it after the label.
 */
import { tipId } from "../lib/tipId.ts";

interface Props {
  text: string;
  class?: string;
  style?: string;
}
const { text, class: cls, style } = Astro.props;
const id = tipId(Astro.request);
---

<span class:list={["tip", cls]} style={style} tabindex="0" aria-describedby={id}><slot /><span role="tooltip" id={id} class="tt">{text}</span></span>
