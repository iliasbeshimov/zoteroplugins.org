---
interface Props {
  active?: "" | "browse" | "grade" | "dev" | "install" | "about";
  search?: boolean;
}
const { active = "", search = false } = Astro.props;
const items = [
  ["browse", "Browse", "/browse"],
  ["grade", "How we grade", "/how-we-grade"],
  ["install", "How to install a plugin", "/install"],
  ["about", "About", "/about"],
] as const;
---

<header class="site-header">
  <a href="/" class="brand">
    <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true">
      <circle cx="6.5" cy="6.5" r="4.2" fill="none" stroke="currentColor" stroke-width="2.2"></circle>
      <path d="M19.5 1.8 24.2 6.5 19.5 11.2 14.8 6.5Z" style="fill:var(--accent)"></path>
      <path d="M4.5 14.8h4l2.7 2.7v4L8.5 24.2h-4l-2.7-2.7v-4Z" fill="currentColor"></path>
      <circle cx="19.5" cy="19.5" r="4.2" fill="none" stroke="currentColor" stroke-width="2.2" stroke-dasharray="2.4 2"></circle>
    </svg>
    <span class="wordmark">Zotero Plugins Atlas</span>
  </a>
  {
    search && (
      <form action="/browse" method="get" role="search" class="search">
        <span aria-hidden="true" class="glass" />
        <label class="visually-hidden" for="hdr-q">Search plugins</label>
        <input id="hdr-q" name="q" type="search" placeholder="Search plugins, e.g. “chat with my papers”" />
      </form>
    )
  }
  <nav aria-label="Main" class="wide">
    {
      items.map(([k, t, href]) => (
        <a href={href} aria-current={k === active ? "page" : undefined}>
          {t}
        </a>
      ))
    }
  </nav>
  <details class="menu">
    <summary aria-label="Menu"><span></span><span></span><span></span></summary>
    <nav aria-label="Main">
      {
        items.map(([k, t, href]) => (
          <a href={href} aria-current={k === active ? "page" : undefined}>
            {t}
          </a>
        ))
      }
    </nav>
  </details>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 14px var(--gutter);
    border-bottom: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    position: relative;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
    flex: none;
  }
  .wordmark {
    font-size: 18px;
    font-weight: 720;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .search {
    flex: 0 1 420px;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding: 0 14px;
    border-radius: 10px;
    border: 1px solid var(--line-strong);
    background: var(--bg);
  }
  .search:focus-within {
    border-color: var(--ink);
  }
  .search input {
    all: unset;
    flex: 1;
    min-width: 0;
    font-size: 14.5px;
    color: var(--ink);
  }
  .search input::placeholder {
    color: var(--ink-3);
  }
  .glass {
    flex: none;
    width: 12px;
    height: 12px;
    border: 2px solid var(--ink-2);
    border-radius: 50%;
  }
  .wide,
  .menu {
    margin-left: auto;
  }
  .menu {
    display: none;
  }
  nav {
    font-size: 14.5px;
    font-weight: 600;
  }
  .wide {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  nav a {
    white-space: nowrap;
    color: var(--ink);
    text-decoration: none;
    text-underline-offset: 5px;
    text-decoration-thickness: 2px;
  }
  nav a[aria-current="page"],
  nav a:hover {
    text-decoration: underline;
  }
  @media (max-width: 860px) {
    .search,
    .wide {
      display: none;
    }
    .menu {
      display: block;
    }
    .menu summary {
      list-style: none;
      width: 44px;
      height: 44px;
      border-radius: 10px;
      border: 1px solid var(--line-strong);
      background: var(--surface);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      cursor: pointer;
    }
    .menu summary::-webkit-details-marker {
      display: none;
    }
    .menu summary span {
      width: 18px;
      height: 2px;
      background: var(--ink);
    }
    .menu[open] nav {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      position: absolute;
      z-index: 10;
      left: 0;
      right: 0;
      top: 100%;
      background: var(--surface);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow-2);
    }
    .menu[open] nav a {
      padding: 14px var(--gutter);
      border-top: 1px solid var(--line);
    }
  }
</style>
