---
import { fmtDate } from "../lib/atlas.ts";
import { MIN_SHOWN } from "../lib/ratings.ts";
import { STAR_DAYS, type StarHistory, sparkPath } from "../lib/stars.ts";
import GitHubMark from "./GitHubMark.astro";

/**
 * GitHub stars, shown with the ratings until a version has enough ratings for an average: the
 * count, the change over the last weeks and a small chart from the census history. Stars measure
 * interest from people on GitHub, not how well a plugin works, and never change the grade.
 */
interface Props {
  h: StarHistory;
}
const { h } = Astro.props;
const W = 300;
const H = 48;
const path = sparkPath(h.points, W, H);
const first = h.points[0];
const last = h.points[h.points.length - 1];
const weeks = Math.round(STAR_DAYS / 7);
const gainText =
  h.gain === null
    ? null
    : h.gain === 0
      ? `No change in the last ${weeks} weeks`
      : `${h.gain > 0 ? "+" : "−"}${Math.abs(h.gain).toLocaleString("en-US")} in the last ${weeks} weeks`;
const label =
  first && last ? `Stars from ${first[1].toLocaleString("en-US")} on ${fmtDate(first[0])} to ${last[1].toLocaleString("en-US")} on ${fmtDate(last[0])}` : "";
---

<div class="stp">
  <div class="n">
    <GitHubMark size={20} />
    <strong>{h.now.toLocaleString("en-US")}</strong>
    <span>stars on GitHub</span>
  </div>
  {gainText && <span class:list={["up", { down: (h.gain ?? 0) < 0, flat: h.gain === 0 }]}>{gainText}</span>}
  {
    path && (
      <svg class="spark" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-label={label}>
        <path d={`${path} L${W},${H} L0,${H} Z`} class="area" />
        <path d={path} class="line" vector-effect="non-scaling-stroke" />
      </svg>
    )
  }
  <p>
    Stars come from people on GitHub, many of them developers. They show interest, not how well it
    works. Once {MIN_SHOWN} people rate a version, their average takes this place.
  </p>
</div>

<style>
  .stp {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: 6px 24px;
    align-items: center;
    padding: 14px 20px 16px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: var(--surface-2);
  }
  .n {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    color: var(--ink);
  }
  .n strong {
    font-size: 22px;
    font-weight: 720;
    letter-spacing: -0.01em;
  }
  .n span {
    font-size: 14.5px;
    color: var(--ink-2);
  }
  .up {
    font: 600 12.5px/1.3 var(--font-mono);
    color: var(--few-fg);
  }
  .up.flat {
    color: var(--ink-3);
  }
  .up.down {
    color: var(--rev-fg);
  }
  .spark {
    grid-row: 1 / 3;
    grid-column: 2;
    width: 220px;
    height: 48px;
  }
  .spark .area {
    fill: var(--few-bg);
  }
  .spark .line {
    fill: none;
    stroke: var(--few-fg);
    stroke-width: 2;
  }
  p {
    grid-column: 1 / -1;
    margin: 6px 0 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 70ch;
  }
  @media (max-width: 720px) {
    .stp {
      grid-template-columns: minmax(0, 1fr);
    }
    .spark {
      grid-row: auto;
      grid-column: auto;
      width: 100%;
    }
  }
</style>
