---
/**
 * Ranked horizontal bars in plain HTML: one series, largest first, one hue. Each row prints its
 * name and value, so the chart is its own table; the bar adds the comparison.
 */
interface Item {
  name: string;
  value: number;
  /** The value as printed (defaults to the number with separators). */
  text?: string;
  href?: string;
  /** A short grey note after the name. */
  note?: string;
}
interface Props {
  items: Item[];
  caption?: string;
  /** Scale against this instead of the largest value (for shares of a whole). */
  max?: number;
}
const { items, caption, max: given } = Astro.props;
const max = given ?? Math.max(...items.map((i) => i.value), 1);
---

<figure class="bars">
  <ol>
    {
      items.map((i) => (
        <li>
          <span class="name">
            {i.href ? <a href={i.href}>{i.name}</a> : i.name}
            {i.note && <span class="note">{i.note}</span>}
          </span>
          <span class="track" aria-hidden="true">
            <span class="bar" style={`width:${Math.max(0.6, (100 * i.value) / max)}%`} />
          </span>
          <span class="val">{i.text ?? i.value.toLocaleString("en-GB")}</span>
        </li>
      ))
    }
  </ol>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .bars {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  li {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    font-size: 15px;
  }
  .name {
    min-width: 0;
    overflow-wrap: anywhere;
    line-height: 1.3;
  }
  .name a {
    color: var(--ink);
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }
  .name a:hover {
    text-decoration-color: currentColor;
  }
  .note {
    color: var(--ink-3);
    font-size: 13px;
    margin-left: 6px;
  }
  .track {
    height: 14px;
    display: flex;
    align-items: center;
  }
  .bar {
    display: block;
    height: 14px;
    background: var(--accent);
    border-radius: 0 4px 4px 0;
  }
  .val {
    font: 600 14px var(--font-sans);
    font-variant-numeric: tabular-nums;
    text-align: right;
    min-width: 3.5em;
  }
  figcaption {
    font-size: 14px;
    color: var(--ink-2);
  }
  @media (max-width: 640px) {
    li {
      grid-template-columns: minmax(0, 1fr) auto;
      row-gap: 4px;
    }
    .track {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
