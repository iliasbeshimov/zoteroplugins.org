---
/** Zotero Atlas's icon: the shelf mark on its parchment tile, with the red leaning book. */
interface Props {
  size?: number;
}
const { size = 22 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 96 96" aria-hidden="true" class="atlas-icon">
  <rect width="96" height="96" rx="22" fill="#f4ecdc"></rect>
  <g fill="#1c1917">
    <rect x="10" y="25" width="14" height="57" rx="3"></rect>
    <rect x="30" y="16" width="14" height="66" rx="3"></rect>
    <rect x="50" y="28" width="12" height="54" rx="3"></rect>
    <rect x="8" y="82" width="79" height="5" rx="2.5"></rect>
  </g>
  <rect x="73.8" y="20" width="13" height="62" rx="3" fill="#c7361f" transform="rotate(-12 86.8 82)"></rect>
</svg>

<style>
  .atlas-icon {
    flex: none;
    display: block;
  }
</style>
