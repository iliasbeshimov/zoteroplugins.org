---
import type { Plugin } from "../lib/atlas.ts";
import { badgeMarkdown, offersBadge } from "../lib/links.ts";
import GitHubMark from "./GitHubMark.astro";

/**
 * The README badge on a plugin page, for its developer: how it looks in a README, its Markdown and
 * a copy button. Offered at A+, A and B; below that, the developer checklist instead. It fills the
 * page's "Is this your plugin?" section (#readme-badge), which the grade card links to; the script
 * here also handles that link.
 */
interface Props {
  p: Plugin;
}
const { p } = Astro.props;
const checklist = `/developers/${p.slug}`;
---

{
  offersBadge(p.grade) ? (
    <>
      <p class="lead">Show its grade in your GitHub README with the Zotero Plugins badge. It updates itself when the grade changes.</p>
      <div class="gh">
        <div class="gh-head">
          <GitHubMark />
          <span>README.md</span>
        </div>
        <div class="gh-body">
          <img src={`/badge/${p.slug}.svg`} alt={`Zotero Plugins grade ${p.grade}`} height="20" loading="lazy" />
        </div>
      </div>
      <div class="snip">
        <code id="readme-badge-md" tabindex="0">{badgeMarkdown(p.slug)}</code>
        <button type="button" class="cp" data-copy-badge="readme-badge-md">
          <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
            <path
              fill="currentColor"
              d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 010 1.5h-1.5a.25.25 0 00-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 00.25-.25v-1.5a.75.75 0 011.5 0v1.5A1.75 1.75 0 019.25 16h-7.5A1.75 1.75 0 010 14.25v-7.5z"
            />
            <path
              fill="currentColor"
              d="M5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0114.25 11h-7.5A1.75 1.75 0 015 9.25v-7.5zm1.75-.25a.25.25 0 00-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 00.25-.25v-7.5a.25.25 0 00-.25-.25h-7.5z"
            />
          </svg>
          <span data-label>Copy</span>
        </button>
      </div>
      <a href={checklist} class="more">
        Developer checklist for this plugin
      </a>
    </>
  ) : p.grade === "C" ? (
    <>
      <p class="lead">
        The developer checklist shows what it takes to reach B, with the file and line for each finding. At B, you can add the Zotero Plugins badge to your GitHub README.
      </p>
      <a href={checklist} class="btn">
        Developer checklist
      </a>
    </>
  ) : (
    <>
      <p class="lead">Once we can grade it, you can add the Zotero Plugins badge to your GitHub README.</p>
      <a href={checklist} class="more">
        Developer checklist for this plugin
      </a>
    </>
  )
}

<script>
  // Copy the badge's Markdown and say so on the button for a moment. Where the clipboard is
  // blocked, select the text instead, ready to copy by hand.
  for (const b of document.querySelectorAll<HTMLButtonElement>("[data-copy-badge]")) {
    const label = b.querySelector<HTMLElement>("[data-label]");
    const code = document.getElementById(b.dataset.copyBadge ?? "");
    b.addEventListener("click", async () => {
      if (!code || !label) return;
      try {
        await navigator.clipboard.writeText(code.textContent?.trim() ?? "");
        label.textContent = "Copied";
        b.classList.add("done");
      } catch {
        const range = document.createRange();
        range.selectNodeContents(code);
        getSelection()?.removeAllRanges();
        getSelection()?.addRange(range);
        label.textContent = "Selected";
      }
      setTimeout(() => {
        label.textContent = "Copy";
        b.classList.remove("done");
      }, 2000);
    });
  }

  // The grade card's "Add this grade to your README" link: scroll here and light the section up
  // for a moment, so the eye lands on it (on a phone it's far down the page).
  const target = document.getElementById("readme-badge");
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const flash = () => {
    if (!target || still) return;
    target.classList.remove("flash");
    void target.offsetWidth;
    target.classList.add("flash");
  };
  for (const a of document.querySelectorAll<HTMLAnchorElement>("[data-readme-jump]"))
    a.addEventListener("click", (e) => {
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: still ? "auto" : "smooth", block: "start" });
      history.replaceState(null, "", "#readme-badge");
      setTimeout(flash, 450);
    });
  if (location.hash === "#readme-badge") flash();
</script>

<style>
  .lead {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  /* A plain stand-in for a GitHub README: GitHub's light colours and system fonts. */
  .gh {
    border: 1px solid #d1d9e0;
    border-radius: 8px;
    background: #fff;
    overflow: hidden;
  }
  .gh-head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    background: #f6f8fa;
    border-bottom: 1px solid #d1d9e0;
    font: 600 13px/1 -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans", Helvetica, Arial, sans-serif;
    color: #1f2328;
  }
  .gh-body {
    display: flex;
    align-items: center;
    padding: 16px 12px;
  }
  .gh-body img {
    display: block;
  }
  .snip {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--code-bg);
    overflow: hidden;
  }
  .snip code {
    flex: 1;
    min-width: 0;
    padding: 10px 12px;
    font: 500 12.5px/1.5 var(--font-mono);
    color: var(--ink-2);
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .cp {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 14px;
    border: 0;
    border-left: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    font: 650 14px var(--font-sans);
    cursor: pointer;
  }
  .cp:hover {
    background: var(--surface-2);
  }
  .cp.done {
    background: var(--few-bg);
    color: var(--few-fg);
  }
  .more {
    font-size: 14px;
  }
  .btn {
    align-self: flex-start;
  }
  :global(#readme-badge) {
    scroll-margin-top: 24px;
    border-radius: 4px;
  }
  :global(#readme-badge.flash) {
    animation: readme-flash 2.2s ease-out;
  }
  @keyframes readme-flash {
    0%,
    35% {
      background: var(--accent-soft);
      box-shadow: 0 0 0 14px var(--accent-soft);
    }
    100% {
      background: transparent;
      box-shadow: 0 0 0 14px transparent;
    }
  }
</style>
