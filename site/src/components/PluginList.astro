---
import { GRADES, type Plugin, testingOpen } from "../lib/atlas.ts";
import { JOBS } from "@atlas/schema";
import CompactCard from "./CompactCard.astro";
import GradeTag from "./GradeTag.astro";

/**
 * Cards with the filters people actually ask about (works with my Zotero, API key, docs language,
 * grade). Filtering, search and sorting run in the browser over the server-rendered cards; the
 * search index (lib/search.ts) is fetched from /search.json the first time it's needed. The grade
 * is a filter but never the sort: a worse-graded plugin that does exactly the job still shows up.
 * The sort (?sort=used|downloads|new) is most downloaded by default, the order the cards render in;
 * a search sorts by best match until another sort is picked.
 */
interface Props {
  plugins: Plugin[];
  currentMajor: number;
  /** Search box and job filter (the browse page). */
  search?: boolean;
  /** Tick up to three plugins to compare (category pages). */
  compare?: boolean;
}
const { plugins, currentMajor, search = false, compare = false } = Astro.props;
const noEnCount = plugins.filter((p) => p.docsOnly).length;
// Each grade's count with no filters on, so the buttons don't change width when the script fills
// them in (which moved the cards below them once the page had painted).
const gradeCount: Record<string, number> = {};
for (const p of plugins) gradeCount[p.grade] = (gradeCount[p.grade] ?? 0) + 1;
const toggles = [
  ["local", "Can use a local model"],
  ["nokey", "Works without an API key"],
  ["hidenoen", `Hide docs not in English (${noEnCount})`],
];
// Versions offered in "Your Zotero": the current one first, then the beta once Zotero has opened
// its testing (before that, few plugins declare it, as Zotero asks), then older majors.
const beta = plugins
  .flatMap((p) => p.worksWith)
  .find((v) => v.includes("beta") && testingOpen(Number.parseInt(v, 10)));
const versions: [string, string][] = [
  [String(currentMajor), `Zotero ${currentMajor} (current)`],
  ...(beta ? ([[beta, `Zotero ${beta}`]] as [string, string][]) : []),
  ...[currentMajor - 1, currentMajor - 2, currentMajor - 3].filter((v) => v >= 7).map((v): [string, string] => [String(v), `Zotero ${v}`]),
];
---

<div class="plist" data-plugin-list data-compare={compare ? "1" : undefined}>
  {
    search && (
      <div class="searchbar">
        <label class="bigsearch">
          <span aria-hidden="true" class="glass" />
          <span class="visually-hidden">What do you want Zotero to do?</span>
          <input type="search" name="q" data-q placeholder="What do you want Zotero to do?" autocomplete="off" />
        </label>
        <label class="field jobfield">
          <span class="visually-hidden">Job</span>
          <select data-job>
            <option value="">Any job</option>
            {JOBS.map((j) => (
              <option value={j.slug}>{j.title}</option>
            ))}
          </select>
        </label>
      </div>
    )
  }
  <div role="group" aria-label="Filters" class="bar">
    <label class="field">
      <span class="fl">Your Zotero</span>
      <select data-zotero>
        <option value="">Any version</option>
        {versions.map(([v, t]) => <option value={v}>{t}</option>)}
      </select>
    </label>
    {
      toggles.map(([k, t]) => (
        <button type="button" class="chip-btn" aria-pressed="false" data-toggle={k}>
          <span aria-hidden="true" class="box" />
          {t}
        </button>
      ))
    }
  </div>
  <div role="group" aria-labelledby="grade-label" class="gradeset">
    <span class="eyebrow" id="grade-label">Zotero Plugins grade</span>
    <div class="grades">
      {
        GRADES.map((g) => (
          <button type="button" class="gbtn" aria-pressed="false" data-grade-btn={g.g} style={`--on-bg:var(--${g.tone}-bg);--on-bd:var(--${g.tone}-fg)`}>
            <GradeTag grade={g.g} size="xs" />
            {g.g === "A+" ? "Tested in Zotero" : g.word}
            <span class="n" data-grade-n>{gradeCount[g.g] ?? 0}</span>
          </button>
        ))
      }
    </div>
  </div>
  <div class="rule-head counthead">
    <span class="count" aria-live="polite"><span data-count>{plugins.length}</span> plugins</span>
    <label class="field">
      <span class="fl">Sort by</span>
      <select data-sort>
        <option value="match" disabled>Best match</option>
        <option value="used">Most used</option>
        <option value="downloads" selected>Most downloaded</option>
        <option value="new">Newest</option>
      </select>
    </label>
  </div>
  <div class="cards" data-cards>
    {
      plugins.map((p) => (
        <div
          class:list={["cell", { cmp: compare }]}
          data-slug={p.slug}
          data-name={p.name}
          data-grade={p.grade}
          data-works={`|${p.worksWith.join("|")}|`}
          data-key={p.keyNeed}
          data-local={p.localModel ? "1" : "0"}
          data-noen={p.docsOnly ? "1" : "0"}
          data-jobs={p.jobs.join(" ")}
          data-dl={p.downloadsN}
          data-use={p.inUse ?? 0}
          data-created={p.createdAt ?? ""}
        >
          {compare && (
            <button type="button" role="checkbox" aria-checked="false" aria-label={`Compare ${p.name}`} class="tick" data-tick>
              ✓
            </button>
          )}
          <CompactCard p={p} />
        </div>
      ))
    }
  </div>
  <div class="dashed-note" data-none hidden>No plugins match these filters.</div>
  <button type="button" class="btn more" data-more hidden>Show more</button>
  {
    compare && (
      <div class="tray" data-tray hidden>
        <span class="tl">Compare</span>
        <div class="tnames" data-tray-names />
        <a href="/compare" class="tgo" data-tray-go>
          Compare →
        </a>
      </div>
    )
  }
</div>

<script>
  import { createIndex, search as runSearch, type SearchDoc, type SearchIndex } from "../lib/search.ts";

  const PAGE = 40;
  for (const root of document.querySelectorAll<HTMLElement>("[data-plugin-list]")) {
    const cells = [...root.querySelectorAll<HTMLElement>("[data-cards] > .cell")];
    const container = root.querySelector<HTMLElement>("[data-cards]")!;
    const qInput = root.querySelector<HTMLInputElement>("[data-q]");
    const jobSel = root.querySelector<HTMLSelectElement>("[data-job]");
    const zSel = root.querySelector<HTMLSelectElement>("[data-zotero]")!;
    // The Zotero version is per-viewer: from the URL, else the last one this browser picked.
    let savedZ = "";
    try {
      savedZ = localStorage.getItem("atlas.zotero") ?? "";
    } catch {}
    const wantZ = new URLSearchParams(location.search).get("zotero") ?? savedZ;
    if ([...zSel.options].some((o) => o.value === wantZ)) zSel.value = wantZ;
    const more = root.querySelector<HTMLButtonElement>("[data-more]")!;
    const none = root.querySelector<HTMLElement>("[data-none]")!;
    const countEl = root.querySelector<HTMLElement>("[data-count]")!;
    const sortSel = root.querySelector<HTMLSelectElement>("[data-sort]")!;
    const matchOpt = sortSel.querySelector<HTMLOptionElement>('option[value="match"]')!;
    const params = new URLSearchParams(location.search);
    const on = new Set<string>();
    const grades = new Set<string>();
    let limit = PAGE;
    type Sort = "match" | "used" | "downloads" | "new";
    const SORTS: Sort[] = ["used", "downloads", "new"];
    // The sort picked (or from ?sort=), used whenever there's no search to rank by match.
    let baseSort: Sort = SORTS.find((x) => x === params.get("sort")) ?? "downloads";
    let byMatch = false;
    if (qInput) {
      qInput.value = params.get("q") ?? "";
      byMatch = !!qInput.value.trim();
    }
    if (jobSel) jobSel.value = params.get("job") ?? "";
    for (const g of (params.get("grade") ?? "").split(",").filter(Boolean)) {
      grades.add(g);
      root.querySelector(`[data-grade-btn="${CSS.escape(g)}"]`)?.setAttribute("aria-pressed", "true");
    }

    // The search index is fetched and built on first use (at once when the page opens with ?q=).
    let index: SearchIndex | null = null;
    let loading: Promise<void> | null = null;
    const loadIndex = () => {
      loading ??= fetch("/search.json")
        .then((r) => r.json() as Promise<SearchDoc[]>)
        .then((docs) => {
          index = createIndex(docs);
          render();
        })
        .catch(() => {
          loading = null; // the next keystroke tries again
        });
      return loading;
    };

    function render() {
      const q = qInput?.value.trim() ?? "";
      // null: no query, every card is a hit. undefined: the index is still loading.
      let hits: Map<string, number> | null | undefined = null;
      if (q) {
        if (index) {
          const found = runSearch(index, q);
          hits = found ? new Map(found.map((h) => [h.slug, h.score])) : null;
        } else {
          void loadIndex();
          hits = undefined;
        }
      }
      const job = jobSel?.value ?? "";
      const zv = zSel.value;
      if (zv) root.dataset.zv = zv;
      else delete root.dataset.zv;
      const pre: [HTMLElement, number][] = [];
      for (const c of cells) {
        const d = c.dataset;
        if (zv && !(d.works ?? "").includes(`|${zv}|`)) continue;
        if (on.has("nokey") && d.key !== "none" && d.key !== "optional") continue;
        if (on.has("local") && d.local !== "1") continue;
        if (on.has("hidenoen") && d.noen === "1") continue;
        if (job && !(d.jobs ?? "").split(" ").includes(job)) continue;
        if (hits === undefined) continue;
        const s = hits ? hits.get(d.slug ?? "") : 1;
        if (s !== undefined) pre.push([c, s]);
      }
      const counts: Record<string, number> = {};
      for (const [c] of pre) counts[c.dataset.grade!] = (counts[c.dataset.grade!] ?? 0) + 1;
      for (const b of root.querySelectorAll<HTMLElement>("[data-grade-btn]"))
        b.querySelector("[data-grade-n]")!.textContent = String(counts[b.dataset.gradeBtn!] ?? 0);
      const shown = pre.filter(([c]) => !grades.size || grades.has(c.dataset.grade!));
      const sort: Sort = byMatch && hits ? "match" : baseSort;
      const num = (c: HTMLElement, k: string) => Number(c.dataset[k]) || 0;
      shown.sort(([a, sa], [b, sb]) => {
        const first =
          sort === "match"
            ? sb - sa
            : sort === "used"
              ? num(b, "use") - num(a, "use")
              : sort === "new"
                ? (b.dataset.created ?? "").localeCompare(a.dataset.created ?? "")
                : 0;
        return first || num(b, "dl") - num(a, "dl");
      });
      matchOpt.disabled = !hits;
      sortSel.value = sort;
      for (const c of cells) c.hidden = true;
      shown.forEach(([c], i) => {
        container.appendChild(c);
        c.hidden = i >= limit;
      });
      countEl.textContent = hits === undefined ? "…" : String(shown.length);
      none.hidden = shown.length > 0 || hits === undefined;
      more.hidden = shown.length <= limit;
      more.textContent = `Show more (${shown.length - limit} left)`;
    }

    function syncUrl() {
      const u = new URL(location.href);
      if (zSel.value) u.searchParams.set("zotero", zSel.value);
      else u.searchParams.delete("zotero");
      if (baseSort !== "downloads") u.searchParams.set("sort", baseSort);
      else u.searchParams.delete("sort");
      if (!qInput) {
        history.replaceState(null, "", u);
        return;
      }
      const q = qInput.value.trim();
      if (q) u.searchParams.set("q", q);
      else u.searchParams.delete("q");
      if (jobSel?.value) u.searchParams.set("job", jobSel.value);
      else u.searchParams.delete("job");
      history.replaceState(null, "", u);
    }

    for (const b of root.querySelectorAll<HTMLButtonElement>("[data-toggle]"))
      b.addEventListener("click", () => {
        const k = b.dataset.toggle!;
        on.has(k) ? on.delete(k) : on.add(k);
        b.setAttribute("aria-pressed", String(on.has(k)));
        limit = PAGE;
        render();
      });
    for (const b of root.querySelectorAll<HTMLButtonElement>("[data-grade-btn]"))
      b.addEventListener("click", () => {
        const g = b.dataset.gradeBtn!;
        grades.has(g) ? grades.delete(g) : grades.add(g);
        b.setAttribute("aria-pressed", String(grades.has(g)));
        limit = PAGE;
        render();
      });
    qInput?.addEventListener("focus", () => void loadIndex(), { once: true });
    // A new search ranks by match; refining one keeps the sort the viewer picked.
    let hadQuery = byMatch;
    qInput?.addEventListener("input", () => {
      const hasQuery = !!qInput.value.trim();
      if (hasQuery && !hadQuery) byMatch = true;
      hadQuery = hasQuery;
      limit = PAGE;
      render();
      syncUrl();
    });
    zSel.addEventListener("change", () => {
      try {
        localStorage.setItem("atlas.zotero", zSel.value);
      } catch {}
      limit = PAGE;
      render();
      syncUrl();
    });
    jobSel?.addEventListener("change", () => {
      limit = PAGE;
      render();
      syncUrl();
    });
    sortSel.addEventListener("change", () => {
      const v = sortSel.value as Sort;
      byMatch = v === "match";
      if (v !== "match") baseSort = v;
      limit = PAGE;
      render();
      syncUrl();
    });
    more.addEventListener("click", () => {
      limit += PAGE;
      render();
    });

    // Compare: tick up to three.
    if (root.dataset.compare) {
      const picked: string[] = [];
      const tray = root.querySelector<HTMLElement>("[data-tray]")!;
      const names = root.querySelector<HTMLElement>("[data-tray-names]")!;
      const go = root.querySelector<HTMLAnchorElement>("[data-tray-go]")!;
      const update = () => {
        for (const c of cells) {
          const t = c.querySelector<HTMLButtonElement>("[data-tick]")!;
          const sel = picked.includes(c.dataset.slug!);
          t.setAttribute("aria-checked", String(sel));
          t.disabled = !sel && picked.length >= 3;
        }
        names.replaceChildren(
          ...picked.map((s) => {
            const c = cells.find((x) => x.dataset.slug === s)!;
            const span = document.createElement("span");
            span.className = "tname";
            span.textContent = `${c.dataset.grade} · ${c.dataset.name}`;
            return span;
          }),
        );
        tray.hidden = picked.length === 0;
        go.href = `/compare?p=${picked.map(encodeURIComponent).join(",")}`;
        go.textContent = picked.length < 2 ? "Pick one more" : `Compare ${picked.length} →`;
        go.toggleAttribute("aria-disabled", picked.length < 2);
      };
      for (const c of cells)
        c.querySelector("[data-tick]")!.addEventListener("click", () => {
          const s = c.dataset.slug!;
          const i = picked.indexOf(s);
          if (i >= 0) picked.splice(i, 1);
          else if (picked.length < 3) picked.push(s);
          update();
        });
      go.addEventListener("click", (e) => {
        if (picked.length < 2) e.preventDefault();
      });
    }
    render();
  }
</script>

<style>
  .plist {
    container: plist / inline-size;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  /* Search, with the job picker on its right: both answer "what do you want Zotero to do?". */
  .searchbar {
    display: flex;
    align-items: stretch;
    border-radius: 14px;
    border: 1.5px solid var(--ink);
    background: var(--surface);
    box-shadow: var(--shadow-1);
  }
  .bigsearch {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
  }
  .bigsearch input {
    all: unset;
    flex: 1;
    min-width: 0;
    font-size: 19px;
    color: var(--ink);
  }
  .bigsearch input::placeholder {
    color: var(--ink-3);
  }
  .glass {
    flex: none;
    width: 14px;
    height: 14px;
    border: 2.5px solid var(--ink);
    border-radius: 50%;
  }
  /* A select in a box of its own, with an optional label inside and a drawn chevron, so every
     control in the filters shares one height, corner and border. */
  .field {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding-left: 14px;
    border-radius: 10px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
  }
  .field:focus-within {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .field select {
    appearance: none;
    align-self: stretch;
    min-width: 0;
    margin: 0;
    padding: 0 36px 0 0;
    border: 0;
    border-radius: 0 10px 10px 0;
    background: transparent;
    color: inherit;
    font: 600 14px var(--font-sans);
    cursor: pointer;
    outline: none;
  }
  .field::after {
    content: "";
    position: absolute;
    right: 15px;
    top: 50%;
    width: 7px;
    height: 7px;
    border-right: 1.75px solid var(--ink-2);
    border-bottom: 1.75px solid var(--ink-2);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }
  .fl {
    font: 600 11px/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    white-space: nowrap;
  }
  .jobfield {
    flex: none;
    width: 230px;
    min-height: 0;
    border: 0;
    border-left: 1px solid var(--line);
    border-radius: 0 12px 12px 0;
    background: transparent;
    padding-left: 18px;
  }
  .jobfield select {
    flex: 1;
    font-size: 15px;
    border-radius: 0 12px 12px 0;
  }
  .jobfield:focus-within {
    outline-offset: -3px;
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .bar .chip-btn {
    border-radius: 10px;
  }
  .bar .chip-btn,
  .field {
    flex: none;
  }
  .box {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    border: 1.5px solid currentColor;
    display: grid;
    place-items: center;
    font-size: 11px;
    line-height: 1;
  }
  [aria-pressed="true"] .box::before {
    content: "✓";
  }
  .gradeset {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  /* One column per grade across the full width: equal, unless a tile's words need more. */
  .grades {
    display: grid;
    grid-template-columns: repeat(5, minmax(max-content, 1fr));
    gap: 8px;
  }
  .gbtn {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 14px 0 8px;
    border-radius: 10px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
    font: 600 14px var(--font-sans);
    white-space: nowrap;
    cursor: pointer;
  }
  .gbtn[aria-pressed="true"] {
    background: var(--on-bg);
    border-color: var(--on-bd);
    box-shadow: inset 0 0 0 0.5px var(--on-bd);
  }
  .n {
    margin-left: auto;
    font: 500 12px var(--font-mono);
    color: var(--ink-2);
  }
  /* Too narrow for five grade tiles in a row (1030px at today's counts): with a mouse the rows
     wrap into even columns; on touch screens, and on any screen narrower than a tablet, the filter
     and grade rows scroll sideways to the screen edge instead of stacking a row per control. */
  @container plist (max-width: 1039px) {
    .grades {
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    }
  }
  @media (pointer: coarse) {
    @container plist (max-width: 1039px) {
      .bar,
      .grades {
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        scrollbar-width: none;
        margin: -5px calc(-1 * var(--gutter));
        padding: 5px var(--gutter);
        scroll-padding-inline: var(--gutter);
      }
      .gbtn {
        flex: none;
      }
    }
  }
  @container plist (max-width: 640px) {
    .bar,
    .grades {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: thin;
      margin: -5px calc(-1 * var(--gutter));
      padding: 5px var(--gutter);
      scroll-padding-inline: var(--gutter);
    }
    .gbtn {
      flex: none;
    }
    /* Phones: the job picker drops under the search. */
    .searchbar {
      flex-direction: column;
    }
    .bigsearch {
      padding: 13px 16px;
    }
    .bigsearch input {
      font-size: 17px;
    }
    .jobfield {
      width: auto;
      min-height: 44px;
      border-left: 0;
      border-top: 1px solid var(--line);
      border-radius: 0 0 12px 12px;
      padding-left: 16px;
    }
    .jobfield select {
      border-radius: 0 0 12px 12px;
    }
  }
  .counthead {
    align-items: baseline;
  }
  .count {
    font-size: 15px;
    font-weight: 650;
  }
  .cards {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .cell.cmp {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 8px;
    align-items: start;
  }
  .cell[hidden] {
    display: none;
  }
  .tick {
    margin-top: 18px;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    border: 2px solid var(--line-strong);
    background: var(--surface);
    color: transparent;
    font: 800 15px/1 var(--font-sans);
    cursor: pointer;
    display: grid;
    place-items: center;
    padding: 0;
  }
  .tick[aria-checked="true"] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--surface);
  }
  .tick:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .more {
    align-self: center;
  }
  .tray {
    position: sticky;
    bottom: 16px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 16px;
    padding: 12px 12px 12px 20px;
    border-radius: 14px;
    background: var(--ink);
    color: var(--surface);
    box-shadow: var(--shadow-2);
  }
  .tray[hidden] {
    display: none;
  }
  .tl {
    font-size: 15px;
    font-weight: 650;
  }
  .tnames {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .tnames :global(.tname) {
    display: flex;
    align-items: center;
    height: 32px;
    padding: 0 10px;
    border-radius: 8px;
    background: oklch(1 0 0 / 0.12);
    font-size: 14px;
  }
  .tgo {
    margin-left: auto;
    height: 40px;
    display: flex;
    align-items: center;
    padding: 0 16px;
    border-radius: 10px;
    background: var(--surface);
    color: var(--ink);
    font-weight: 650;
    font-size: 14.5px;
    text-decoration: none;
  }
  .tgo[aria-disabled] {
    opacity: 0.6;
    cursor: default;
  }
</style>
