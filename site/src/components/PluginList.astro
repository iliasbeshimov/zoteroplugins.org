---
import { GRADES, type Plugin } from "../lib/atlas.ts";
import { JOBS } from "../lib/jobs.ts";
import CompactCard from "./CompactCard.astro";
import GradeTag from "./GradeTag.astro";

/**
 * Cards with the filters people actually ask about (works with my Zotero, API key, docs language,
 * grade). Filtering, search and sorting run in the browser over the server-rendered cards; the
 * search index (lib/search.ts) is fetched from /search.json the first time it's needed. The grade
 * is a filter but never the sort: a worse-graded plugin that does exactly the job still shows up.
 */
interface Props {
  plugins: Plugin[];
  currentMajor: number;
  /** Search box and job filter (the browse page). */
  search?: boolean;
  /** Tick up to three plugins to compare (category pages). */
  compare?: boolean;
}
const { plugins, currentMajor, search = false, compare = false } = Astro.props;
const cnCount = plugins.filter((p) => p.chineseDocs).length;
const toggles = [
  ["local", "Can use a local model"],
  ["nokey", "Works without an API key"],
  ["hidecn", `Hide Chinese-only docs (${cnCount})`],
];
// Versions offered in "Your Zotero": the current one first, then the beta, then older majors.
const beta = plugins.flatMap((p) => p.worksWith).find((v) => v.includes("beta"));
const versions: [string, string][] = [
  [String(currentMajor), `Zotero ${currentMajor} (current)`],
  ...(beta ? ([[beta, `Zotero ${beta}`]] as [string, string][]) : []),
  ...[currentMajor - 1, currentMajor - 2, currentMajor - 3].filter((v) => v >= 7).map((v): [string, string] => [String(v), `Zotero ${v}`]),
];
---

<div class="plist" data-plugin-list data-compare={compare ? "1" : undefined}>
  {
    search && (
      <label class="bigsearch">
        <span aria-hidden="true" class="glass" />
        <span class="visually-hidden">What do you want Zotero to do?</span>
        <input type="search" name="q" data-q placeholder="What do you want Zotero to do?" autocomplete="off" />
      </label>
    )
  }
  <div role="group" aria-label="Filters" class="row">
    <label class="select zsel">
      <span class="zl">Your Zotero</span>
      <select data-zotero>
        <option value="">Any version</option>
        {versions.map(([v, t]) => <option value={v}>{t}</option>)}
      </select>
    </label>
    <span class="sep" />
    {
      toggles.map(([k, t]) => (
        <button type="button" class="chip-btn" aria-pressed="false" data-toggle={k}>
          <span aria-hidden="true" class="box" />
          {t}
        </button>
      ))
    }
    {
      search && (
        <>
          <span class="sep" />
          <label class="select">
            <span class="visually-hidden">Job</span>
            <select data-job>
              <option value="">Any job</option>
              {JOBS.map((j) => (
                <option value={j.slug}>{j.title}</option>
              ))}
            </select>
          </label>
        </>
      )
    }
  </div>
  <div role="group" aria-label="Atlas grade" class="row">
    <span class="eyebrow gl">Atlas grade</span>
    {
      GRADES.map((g) => (
        <button type="button" class="gbtn" aria-pressed="false" data-grade-btn={g.g} style={`--on-bg:var(--${g.tone}-bg);--on-bd:var(--${g.tone}-fg)`}>
          <GradeTag grade={g.g} size="xs" />
          {g.g === "A+" ? "Tested in Zotero" : g.word}
          <span class="n" data-grade-n />
        </button>
      ))
    }
  </div>
  <div class="rule-head counthead">
    <span class="count" aria-live="polite"><span data-count>{plugins.length}</span> plugins</span>
    <span class="sort">
      Sorted by <span data-sort-label>most downloaded</span> · <button type="button" class="linkbtn" data-sort-toggle>Sort by relevance</button>
    </span>
  </div>
  <div class="cards" data-cards>
    {
      plugins.map((p) => (
        <div
          class:list={["cell", { cmp: compare }]}
          data-slug={p.slug}
          data-name={p.name}
          data-grade={p.grade}
          data-works={`|${p.worksWith.join("|")}|`}
          data-key={p.keyNeed}
          data-local={p.localModel ? "1" : "0"}
          data-cn={p.chineseDocs ? "1" : "0"}
          data-jobs={p.jobs.join(" ")}
          data-dl={p.downloadsN}
        >
          {compare && (
            <button type="button" role="checkbox" aria-checked="false" aria-label={`Compare ${p.name}`} class="tick" data-tick>
              ✓
            </button>
          )}
          <CompactCard p={p} />
        </div>
      ))
    }
  </div>
  <div class="dashed-note" data-none hidden>No plugins match these filters.</div>
  <button type="button" class="btn more" data-more hidden>Show more</button>
  {
    compare && (
      <div class="tray" data-tray hidden>
        <span class="tl">Compare</span>
        <div class="tnames" data-tray-names />
        <a href="/compare" class="tgo" data-tray-go>
          Compare →
        </a>
      </div>
    )
  }
</div>

<script>
  import { createIndex, search as runSearch, type SearchDoc, type SearchIndex } from "../lib/search.ts";

  const PAGE = 40;
  for (const root of document.querySelectorAll<HTMLElement>("[data-plugin-list]")) {
    const cells = [...root.querySelectorAll<HTMLElement>("[data-cards] > .cell")];
    const container = root.querySelector<HTMLElement>("[data-cards]")!;
    const qInput = root.querySelector<HTMLInputElement>("[data-q]");
    const jobSel = root.querySelector<HTMLSelectElement>("[data-job]");
    const zSel = root.querySelector<HTMLSelectElement>("[data-zotero]")!;
    // The Zotero version is per-viewer: from the URL, else the last one this browser picked.
    let savedZ = "";
    try {
      savedZ = localStorage.getItem("atlas.zotero") ?? "";
    } catch {}
    const wantZ = new URLSearchParams(location.search).get("zotero") ?? savedZ;
    if ([...zSel.options].some((o) => o.value === wantZ)) zSel.value = wantZ;
    const more = root.querySelector<HTMLButtonElement>("[data-more]")!;
    const none = root.querySelector<HTMLElement>("[data-none]")!;
    const countEl = root.querySelector<HTMLElement>("[data-count]")!;
    const sortLabel = root.querySelector<HTMLElement>("[data-sort-label]")!;
    const sortBtn = root.querySelector<HTMLButtonElement>("[data-sort-toggle]")!;
    const params = new URLSearchParams(location.search);
    const on = new Set<string>();
    const grades = new Set<string>();
    let limit = PAGE;
    let byRelevance = false;
    if (qInput) {
      qInput.value = params.get("q") ?? "";
      byRelevance = !!qInput.value.trim();
    }
    if (jobSel) jobSel.value = params.get("job") ?? "";
    for (const g of (params.get("grade") ?? "").split(",").filter(Boolean)) {
      grades.add(g);
      root.querySelector(`[data-grade-btn="${CSS.escape(g)}"]`)?.setAttribute("aria-pressed", "true");
    }

    // The search index is fetched and built on first use (at once when the page opens with ?q=).
    let index: SearchIndex | null = null;
    let loading: Promise<void> | null = null;
    const loadIndex = () => {
      loading ??= fetch("/search.json")
        .then((r) => r.json() as Promise<SearchDoc[]>)
        .then((docs) => {
          index = createIndex(docs);
          render();
        })
        .catch(() => {
          loading = null; // the next keystroke tries again
        });
      return loading;
    };

    function render() {
      const q = qInput?.value.trim() ?? "";
      // null: no query, every card is a hit. undefined: the index is still loading.
      let hits: Map<string, number> | null | undefined = null;
      if (q) {
        if (index) {
          const found = runSearch(index, q);
          hits = found ? new Map(found.map((h) => [h.slug, h.score])) : null;
        } else {
          void loadIndex();
          hits = undefined;
        }
      }
      const job = jobSel?.value ?? "";
      const zv = zSel.value;
      if (zv) root.dataset.zv = zv;
      else delete root.dataset.zv;
      const pre: [HTMLElement, number][] = [];
      for (const c of cells) {
        const d = c.dataset;
        if (zv && !(d.works ?? "").includes(`|${zv}|`)) continue;
        if (on.has("nokey") && d.key !== "none" && d.key !== "optional") continue;
        if (on.has("local") && d.local !== "1") continue;
        if (on.has("hidecn") && d.cn === "1") continue;
        if (job && !(d.jobs ?? "").split(" ").includes(job)) continue;
        if (hits === undefined) continue;
        const s = hits ? hits.get(d.slug ?? "") : 1;
        if (s !== undefined) pre.push([c, s]);
      }
      const counts: Record<string, number> = {};
      for (const [c] of pre) counts[c.dataset.grade!] = (counts[c.dataset.grade!] ?? 0) + 1;
      for (const b of root.querySelectorAll<HTMLElement>("[data-grade-btn]"))
        b.querySelector("[data-grade-n]")!.textContent = String(counts[b.dataset.gradeBtn!] ?? 0);
      const shown = pre.filter(([c]) => !grades.size || grades.has(c.dataset.grade!));
      const rel = byRelevance && !!hits;
      shown.sort(([a, sa], [b, sb]) => (rel ? sb - sa : 0) || Number(b.dataset.dl) - Number(a.dataset.dl));
      sortLabel.textContent = rel ? "relevance" : "most downloaded";
      sortBtn.textContent = rel ? "Most downloaded" : "Sort by relevance";
      sortBtn.hidden = !hits;
      for (const c of cells) c.hidden = true;
      shown.forEach(([c], i) => {
        container.appendChild(c);
        c.hidden = i >= limit;
      });
      countEl.textContent = hits === undefined ? "…" : String(shown.length);
      none.hidden = shown.length > 0 || hits === undefined;
      more.hidden = shown.length <= limit;
      more.textContent = `Show more (${shown.length - limit} left)`;
    }

    function syncUrl() {
      const u = new URL(location.href);
      if (zSel.value) u.searchParams.set("zotero", zSel.value);
      else u.searchParams.delete("zotero");
      if (!qInput) {
        history.replaceState(null, "", u);
        return;
      }
      const q = qInput.value.trim();
      if (q) u.searchParams.set("q", q);
      else u.searchParams.delete("q");
      if (jobSel?.value) u.searchParams.set("job", jobSel.value);
      else u.searchParams.delete("job");
      history.replaceState(null, "", u);
    }

    for (const b of root.querySelectorAll<HTMLButtonElement>("[data-toggle]"))
      b.addEventListener("click", () => {
        const k = b.dataset.toggle!;
        on.has(k) ? on.delete(k) : on.add(k);
        b.setAttribute("aria-pressed", String(on.has(k)));
        limit = PAGE;
        render();
      });
    for (const b of root.querySelectorAll<HTMLButtonElement>("[data-grade-btn]"))
      b.addEventListener("click", () => {
        const g = b.dataset.gradeBtn!;
        grades.has(g) ? grades.delete(g) : grades.add(g);
        b.setAttribute("aria-pressed", String(grades.has(g)));
        limit = PAGE;
        render();
      });
    qInput?.addEventListener("focus", () => void loadIndex(), { once: true });
    qInput?.addEventListener("input", () => {
      byRelevance = true;
      limit = PAGE;
      render();
      syncUrl();
    });
    zSel.addEventListener("change", () => {
      try {
        localStorage.setItem("atlas.zotero", zSel.value);
      } catch {}
      limit = PAGE;
      render();
      syncUrl();
    });
    jobSel?.addEventListener("change", () => {
      limit = PAGE;
      render();
      syncUrl();
    });
    sortBtn.addEventListener("click", () => {
      byRelevance = !byRelevance;
      render();
    });
    more.addEventListener("click", () => {
      limit += PAGE;
      render();
    });

    // Compare: tick up to three.
    if (root.dataset.compare) {
      const picked: string[] = [];
      const tray = root.querySelector<HTMLElement>("[data-tray]")!;
      const names = root.querySelector<HTMLElement>("[data-tray-names]")!;
      const go = root.querySelector<HTMLAnchorElement>("[data-tray-go]")!;
      const update = () => {
        for (const c of cells) {
          const t = c.querySelector<HTMLButtonElement>("[data-tick]")!;
          const sel = picked.includes(c.dataset.slug!);
          t.setAttribute("aria-checked", String(sel));
          t.disabled = !sel && picked.length >= 3;
        }
        names.replaceChildren(
          ...picked.map((s) => {
            const c = cells.find((x) => x.dataset.slug === s)!;
            const span = document.createElement("span");
            span.className = "tname";
            span.textContent = `${c.dataset.grade} · ${c.dataset.name}`;
            return span;
          }),
        );
        tray.hidden = picked.length === 0;
        go.href = `/compare?p=${picked.map(encodeURIComponent).join(",")}`;
        go.textContent = picked.length < 2 ? "Pick one more" : `Compare ${picked.length} →`;
        go.toggleAttribute("aria-disabled", picked.length < 2);
      };
      for (const c of cells)
        c.querySelector("[data-tick]")!.addEventListener("click", () => {
          const s = c.dataset.slug!;
          const i = picked.indexOf(s);
          if (i >= 0) picked.splice(i, 1);
          else if (picked.length < 3) picked.push(s);
          update();
        });
      go.addEventListener("click", (e) => {
        if (picked.length < 2) e.preventDefault();
      });
    }
    render();
  }
</script>

<style>
  .plist {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .bigsearch {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    border-radius: 14px;
    border: 1.5px solid var(--ink);
    background: var(--surface);
    box-shadow: var(--shadow-1);
  }
  .bigsearch input {
    all: unset;
    flex: 1;
    min-width: 0;
    font-size: 19px;
    color: var(--ink);
  }
  .bigsearch input::placeholder {
    color: var(--ink-3);
  }
  .glass {
    flex: none;
    width: 14px;
    height: 14px;
    border: 2.5px solid var(--ink);
    border-radius: 50%;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .box {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    border: 1.5px solid currentColor;
    display: grid;
    place-items: center;
    font-size: 11px;
    line-height: 1;
  }
  [aria-pressed="true"] .box::before {
    content: "✓";
  }
  .sep {
    width: 1px;
    height: 24px;
    background: var(--line-strong);
    margin: 0 4px;
  }
  .select select {
    min-height: 40px;
    padding: 0 14px;
    border-radius: 10px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
    font: 600 14px var(--font-sans);
  }
  .zsel {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .zl {
    font: 600 12px/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .zsel select {
    border-color: var(--ink);
  }
  .gl {
    font-size: 12px;
    margin-right: 4px;
  }
  .gbtn {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 14px 0 8px;
    border-radius: 10px;
    border: 1.5px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
    font: 600 14px var(--font-sans);
    cursor: pointer;
  }
  .gbtn[aria-pressed="true"] {
    background: var(--on-bg);
    border-color: var(--on-bd);
  }
  .n {
    font: 500 12px var(--font-mono);
    color: var(--ink-2);
  }
  .counthead {
    align-items: baseline;
  }
  .count {
    font-size: 15px;
    font-weight: 650;
  }
  .sort {
    font-size: 14px;
    color: var(--ink-2);
  }
  .linkbtn {
    all: unset;
    cursor: pointer;
    color: var(--accent-fg);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cards {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .cell.cmp {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 8px;
    align-items: start;
  }
  .cell[hidden] {
    display: none;
  }
  .tick {
    margin-top: 18px;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    border: 2px solid var(--line-strong);
    background: var(--surface);
    color: transparent;
    font: 800 15px/1 var(--font-sans);
    cursor: pointer;
    display: grid;
    place-items: center;
    padding: 0;
  }
  .tick[aria-checked="true"] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--surface);
  }
  .tick:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .more {
    align-self: center;
  }
  .tray {
    position: sticky;
    bottom: 16px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 16px;
    padding: 12px 12px 12px 20px;
    border-radius: 14px;
    background: var(--ink);
    color: var(--surface);
    box-shadow: var(--shadow-2);
  }
  .tray[hidden] {
    display: none;
  }
  .tl {
    font-size: 15px;
    font-weight: 650;
  }
  .tnames {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .tnames :global(.tname) {
    display: flex;
    align-items: center;
    height: 32px;
    padding: 0 10px;
    border-radius: 8px;
    background: oklch(1 0 0 / 0.12);
    font-size: 14px;
  }
  .tgo {
    margin-left: auto;
    height: 40px;
    display: flex;
    align-items: center;
    padding: 0 16px;
    border-radius: 10px;
    background: var(--surface);
    color: var(--ink);
    font-weight: 650;
    font-size: 14.5px;
    text-decoration: none;
  }
  .tgo[aria-disabled] {
    opacity: 0.6;
    cursor: default;
  }
</style>
