---
import Findings from "../components/Findings.astro";
import GradeTag from "../components/GradeTag.astro";
import PluginIcon from "../components/PluginIcon.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Tip from "../components/Tip.astro";
import Base from "../layouts/Base.astro";
import { CURRENT_ZOTERO_MAJOR, fmtDate, GRADES, type Plugin, shownPlugins } from "../lib/atlas.ts";
import { JOBS } from "@atlas/schema";
import { siteLd } from "../lib/meta.ts";
import { countWord, PACKS, packPath, resolvePack } from "../lib/packs.ts";
import { USE_TIP } from "../lib/usage.ts";

const plugins = shownPlugins();
const tries = ["cite in Word", "translate PDFs", "summarise a paper", "find duplicates"];
const cats = JOBS.map((j) => ({ ...j, n: plugins.filter((p) => p.jobs.includes(j.slug)).length }));
const cur = CURRENT_ZOTERO_MAJOR();
const byUse = (a: Plugin, b: Plugin) => (b.inUse ?? 0) - (a.inUse ?? 0) || b.downloadsN - a.downloadsN;
// The plugins most people have, among those that work with the current Zotero (lib/usage.ts).
const used = plugins.filter((p) => p.currentOk && p.inUse != null).sort(byUse).slice(0, 10);
// The next major, while it's in beta: each row says whether the plugin works with it.
const nextLabel = plugins.flatMap((p) => p.compat).find((c) => c.v.includes("beta"))?.v ?? null;
const nextOf = (p: Plugin) => {
  const c = p.compat.find((x) => x.v === nextLabel);
  return c?.ok === true ? "yes" : c?.ok === false ? "no" : "unknown";
};
const nextTip = {
  yes: `Its latest release works with Zotero ${nextLabel}, the next version.`,
  no: `Its latest release doesn't work with Zotero ${nextLabel} yet. Developers often update before a version comes out of beta.`,
  unknown: `We couldn't tell whether it works with Zotero ${nextLabel}.`,
};
// New: repositories created in the last 90 days of the census, most used first.
const NEW_DAYS = 90;
const asOf = Math.max(...plugins.map((p) => Date.parse(p.checkedAt)));
const fresh = plugins
  .filter((p) => p.currentOk && p.inUse != null && p.createdAt && asOf - Date.parse(p.createdAt) < NEW_DAYS * 86_400_000)
  .sort(byUse)
  .slice(0, 6);
// Written about us. The link's utm_ parameters tell the article's site the visit came from here.
const press = {
  name: "Citation Styler",
  quote: "No advertising, no paid listings, and nobody can buy a better rating.",
  url: "https://citationstyler.com/en/knowledge/zotero-plugins-atlas-the-directory-that-rates-plugins/",
};
const pressLink = `${press.url}?utm_source=zoteroplugins.org&utm_medium=referral&utm_campaign=as-seen-on`;
// Plugin packs: the friendliest way in for a student or researcher new to plugins.
const packs = PACKS.map((pack) => ({ pack, picks: resolvePack(pack) }));
---

<Base
  title="Zotero Plugins Atlas · plugins for Zotero, checked before you install"
  description="Every Zotero plugin gets a grade from a check of its code: what it does, what it needs from you and where it sends your data, with the evidence."
  jsonld={siteLd("Every Zotero plugin, graded from a check of its code: what it does, what it needs from you and where it sends your data.")}
>
  <SiteHeader />
  <main>
  <div class="hero">
    <div class="hl">
      <h1>Plugins for Zotero, checked before you install</h1>
      <form action="/browse" method="get" role="search" class="search">
        <span aria-hidden="true" class="glass"></span>
        <label class="visually-hidden" for="home-q">What do you want Zotero to do?</label>
        <input id="home-q" name="q" type="search" placeholder="What do you want Zotero to do?" />
      </form>
      <div class="tries">
        <span>Try</span>
        {tries.map((t) => <a href={`/browse?q=${encodeURIComponent(t)}`}>{t}</a>)}
      </div>
      <p class="getz">New to Zotero? <a href="https://www.zotero.org/download/">Download it free from zotero.org</a></p>
    </div>
    <div class="ladder">
      <span class="eyebrow">Every plugin gets a grade</span>
      <div class="lg">
        {
          GRADES.map((g) => (
            <>
              <span class="lt">
                <GradeTag grade={g.g} size="xs" />
              </span>
              <strong>{g.long}</strong>
            </>
          ))
        }
      </div>
      <span class="hows"><a href="/how-we-grade" class="how">How we grade</a><a href="/are-zotero-plugins-safe" class="how">Are Zotero plugins safe?</a></span>
    </div>
  </div>

  <aside class="press" aria-label="In the press">
    <a class="who" href={pressLink}>
      <span class="lab">As seen on</span>
      <span class="logo" role="img" aria-label={press.name}></span>
    </a>
    <q cite={press.url}>{press.quote}</q>
    <a class="read" href={pressLink}>Read the article</a>
  </aside>

  <section class="packs-home" aria-labelledby="packs-h">
    <div class="uhead">
      <div class="uh">
        <h2 id="packs-h">Start with a plugin pack</h2>
        <p>Five or six checked plugins for each stage of academic work, each pack with a one-page PDF to print or share.</p>
      </div>
      <a href="/for">All packs and PDFs</a>
    </div>
    <div class="pk-grid">
      {
        packs.map(({ pack, picks }) => (
          <a href={packPath(pack)} class="pk">
            <span class="pk-top">
              <strong>{pack.name}</strong>
              <span class="n">{countWord(picks.length)} plugins</span>
            </span>
            <span class="pk-who">{pack.who}</span>
            <span class="pk-tags" aria-hidden="true">
              {picks.map((k) => <GradeTag grade={k.plugin.grade} size="xs" />)}
            </span>
            <span class="pk-names">{picks.map((k) => k.plugin.name).join(" · ")}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="used" aria-labelledby="used-h">
    <div class="uhead">
      <div class="uh">
        <h2 id="used-h">The most-used plugins, and what we found</h2>
        <p>Ranked by about how many people have each one installed. All {used.length} work with Zotero {cur}.</p>
      </div>
      <a href="/browse?sort=used">All plugins by use</a>
    </div>
    <ol class="ulist">
      {
        used.map((p, i) => {
          const nx = nextOf(p);
          return (
            <li class="urow">
              <span class="rk" aria-hidden="true">{i + 1}</span>
              <span class="ug">
                <GradeTag grade={p.grade} size="sm" />
              </span>
              <div class="ub">
                <span class="unrow">
                  <PluginIcon slug={p.slug} name={p.name} size={24} />
                  <a href={`/p/${p.slug}`} class="un">{p.name}</a>
                </span>
                {(p.grade === "B" || p.grade === "C") && (
                  <p class="uw">
                    <span class="muted">{p.grade} because </span>
                    {p.because}
                  </p>
                )}
                <div class="uf">
                  <Tip text={USE_TIP} class="uu">
                    <strong>{p.inUseText}</strong> in use
                  </Tip>
                  {nextLabel && (
                    <Tip text={nextTip[nx]} class={`nx nx-${nx}`}>
                      {`Zotero ${nextLabel} `}
                      <span aria-hidden="true" class="mk">{nx === "yes" ? "✓" : nx === "no" ? "✗" : "?"}</span>
                      <span class="visually-hidden">{nx === "yes" ? "works" : nx === "no" ? "doesn't work yet" : "not known"}</span>
                    </Tip>
                  )}
                </div>
              </div>
            </li>
          );
        })
      }
    </ol>
  </section>

  <div class="wrap">
    <section>
      <div class="rule-head"><h2>Browse by job</h2><a href="/browse">All {plugins.length.toLocaleString("en-GB")} plugins</a></div>
      <div class="cats">
        {
          cats.map((c) => (
            <a href={`/c/${c.slug}`} class="cat">
              <span class="ct">
                <strong>{c.title}</strong>
                <span class="n">{c.n}</span>
              </span>
              <span class="eg">{c.eg}</span>
            </a>
          ))
        }
      </div>
    </section>
  </div>

  <Findings plugins={plugins} currentMajor={cur} />

  <div class="wrap end">
    <section>
      <div class="rule-head">
        <h2>New and catching on</h2>
        <a href="/browse?sort=new">Newest first</a>
      </div>
      <p class="lede">Plugins first published in the last {NEW_DAYS} days that the most people have installed.</p>
      <div class="fresh">
        {
          fresh.map((p) => (
            <a href={`/p/${p.slug}`} class="fc">
              <span class="fn">
                <GradeTag grade={p.grade} size="xs" />
                <strong>{p.name}</strong>
              </span>
              <span class="fd">{p.oneLiner}</span>
              <span class="fm">
                {[`${p.inUseText} in use`, `since ${fmtDate(p.createdAt).replace(/ \d{4}$/, "")}`, p.docsOnly ? `docs in ${p.docsOnly}` : ""].filter(Boolean).join(" · ")}
              </span>
            </a>
          ))
        }
      </div>
    </section>
  </div>
  </main>
  <SiteFooter />
</Base>

<style>
  .hero {
    padding: 64px var(--gutter) 56px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 380px;
    gap: 56px;
    align-items: center;
    max-width: 1280px;
    margin: 0 auto;
  }
  .hl {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  h1 {
    margin: 0;
    font-size: 60px;
    line-height: 1.02;
    letter-spacing: -0.04em;
    font-weight: 780;
    text-wrap: balance;
  }
  .search {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    border-radius: 14px;
    border: 1.5px solid var(--ink);
    background: var(--surface);
    box-shadow: var(--shadow-2);
  }
  .search input {
    all: unset;
    flex: 1;
    min-width: 0;
    font-size: 20px;
    color: var(--ink);
  }
  .search input::placeholder {
    color: var(--ink-3);
  }
  .glass {
    flex: none;
    width: 15px;
    height: 15px;
    border: 2.5px solid var(--ink);
    border-radius: 50%;
  }
  .getz {
    margin: 0;
    font-size: 14px;
    color: var(--ink-2);
  }
  .getz a {
    font-weight: 600;
  }
  .tries {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }
  .tries span {
    font-size: 14px;
    color: var(--ink-2);
    margin-right: 4px;
  }
  .tries a {
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
    font-size: 14.5px;
    font-weight: 600;
    text-decoration: none;
  }
  .tries a:hover {
    border-color: var(--ink);
  }
  .ladder {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 22px 24px;
    border-radius: 18px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .lg {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 10px 12px;
    align-items: center;
    font-size: 14.5px;
    line-height: 1.3;
  }
  .lg strong {
    font-weight: 650;
  }
  .lt {
    display: flex;
  }
  .how {
    font-size: 14px;
    font-weight: 600;
  }
  .hows {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }
  /* A full-width white band, its content lined up with the 1280px column. */
  .press {
    box-sizing: border-box;
    padding: 30px max(var(--gutter), calc((100% - 1280px) / 2 + var(--gutter)));
    background: var(--surface);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 36px;
  }
  .who {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
  }
  .lab {
    font-size: 15px;
    color: var(--ink-3);
  }
  /* The publisher's logo is white; used as a mask it takes the text colour in both themes. */
  .logo {
    display: block;
    width: 149px;
    height: 40px;
    background: var(--ink-2);
    -webkit-mask: url("/press/citation-styler.png") center / contain no-repeat;
    mask: url("/press/citation-styler.png") center / contain no-repeat;
  }
  .who:hover .logo {
    background: var(--ink);
  }
  .press q {
    flex: 1 1 360px;
    min-width: 0;
    font-size: 21px;
    line-height: 1.35;
    font-style: italic;
    color: var(--ink);
  }
  .read {
    font-size: 16px;
    font-weight: 600;
    white-space: nowrap;
  }
  .wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 48px var(--gutter) 8px;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .wrap.end {
    padding-bottom: 56px;
  }
  section {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .cats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .cat {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 18px 16px;
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }
  .cat:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
  .ct {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    align-items: baseline;
  }
  .ct strong {
    font-size: 18px;
    letter-spacing: -0.01em;
  }
  .n {
    font: 500 12.5px var(--font-mono);
    color: var(--ink-2);
  }
  .eg {
    font-size: 14px;
    line-height: 1.4;
    color: var(--ink-2);
  }
  .lede {
    margin: -6px 0 0;
    font-size: 15px;
    color: var(--ink-2);
  }
  /* Plugin packs: one card per kind of reader, its plugins' grades and names. */
  .packs-home {
    max-width: 1280px;
    margin: 0 auto;
    padding: 48px var(--gutter) 8px;
    gap: 20px;
  }
  .pk-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .pk {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 18px;
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }
  .pk:hover {
    border-color: var(--ink);
  }
  .pk-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
  }
  .pk-top strong {
    font-size: 18px;
    letter-spacing: -0.01em;
  }
  .pk-top .n {
    font: 500 12.5px var(--font-mono);
    color: var(--ink-3);
    white-space: nowrap;
  }
  .pk-who {
    font-size: 14.5px;
    line-height: 1.45;
    color: var(--ink-2);
  }
  .pk-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: auto;
  }
  .pk-names {
    font-size: 13px;
    line-height: 1.45;
    color: var(--ink-3);
  }
  /* The most-used plugins: rank, grade, what it does and why, then use and the next Zotero. */
  .used {
    max-width: 1280px;
    margin: 0 auto;
    padding: 48px var(--gutter) 8px;
    gap: 20px;
  }
  .uhead {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 10px 24px;
  }
  .uh {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .uh h2 {
    margin: 0;
    font-size: 36px;
    line-height: 1.08;
    letter-spacing: -0.03em;
    font-weight: 760;
    text-wrap: balance;
  }
  .uh p {
    margin: 0;
    font-size: 17px;
    color: var(--ink-2);
  }
  .uhead > a {
    font-size: 14.5px;
    font-weight: 600;
  }
  /* Two columns on wide screens, ranked down each column: 1–5, then 6–10. */
  .ulist {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(5, auto);
    grid-auto-flow: column;
    column-gap: 48px;
  }
  .urow {
    display: grid;
    grid-template-columns: 26px 52px minmax(0, 1fr);
    gap: 4px 14px;
    align-items: start;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .rk {
    padding-top: 3px;
    text-align: right;
    font: 600 14px var(--font-mono);
    color: var(--ink-3);
  }
  .ug {
    display: flex;
    padding-top: 2px;
  }
  .ub {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .un {
    font-size: 17.5px;
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .un:hover {
    text-decoration: underline;
  }
  .unrow {
    display: flex;
    align-items: center;
    gap: 9px;
    min-width: 0;
  }
  .uw {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.45;
    color: var(--ink);
  }
  .uw .muted {
    color: var(--ink-2);
  }
  .uf {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    padding-top: 2px;
  }
  .uf :global(.uu) {
    font-size: 14px;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .uf :global(.uu strong) {
    font: 700 15px var(--font-mono);
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .uf :global(.nx) {
    font: 500 12.5px var(--font-mono);
    white-space: nowrap;
  }
  .uf :global(.mk) {
    font: 700 13px var(--font-sans);
  }
  .uf :global(.nx-yes) {
    color: var(--few-fg);
  }
  .uf :global(.nx-no),
  .uf :global(.nx-unknown) {
    color: var(--ink-3);
  }
  /* New and catching on */
  .fresh {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .fc {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px 18px;
    border-radius: 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }
  .fc:hover {
    border-color: var(--ink);
    color: var(--ink);
  }
  .fn {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  .fn strong {
    font-size: 16.5px;
    overflow-wrap: anywhere;
  }
  .fd {
    flex: 1;
    font-size: 14px;
    line-height: 1.45;
    color: var(--ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .fm {
    font: 500 12.5px var(--font-mono);
    color: var(--ink-2);
  }
  @media (max-width: 960px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-top: 28px;
      padding-bottom: 28px;
    }
    h1 {
      font-size: 34px;
      line-height: 1.05;
    }
    .search input {
      font-size: 17px;
    }
    .press q {
      flex-basis: 100%;
      font-size: 18px;
    }
    .tries {
      flex-wrap: nowrap;
      overflow-x: auto;
    }
    .tries a {
      flex: none;
      min-height: 40px;
      display: flex;
      align-items: center;
    }
    .cats {
      grid-template-columns: 1fr 1fr;
    }
    .wrap,
    .used,
    .packs-home {
      padding-top: 28px;
      gap: 40px;
    }
    .packs-home {
      gap: 16px;
    }
    .pk-grid {
      grid-template-columns: 1fr 1fr;
    }
    .used {
      gap: 16px;
    }
    .uh h2 {
      font-size: 28px;
    }
    .uh p {
      font-size: 15.5px;
    }
    .fresh {
      grid-template-columns: 1fr;
    }
    .ulist {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      grid-auto-flow: row;
    }
  }
  @media (max-width: 720px) {
    .pk-grid {
      grid-template-columns: 1fr;
    }
    .urow {
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 6px 12px;
    }
    .rk {
      display: none;
    }
  }
</style>
