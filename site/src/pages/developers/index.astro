---
import GradeTag from "../../components/GradeTag.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import Base from "../../layouts/Base.astro";
import { SITE, RESPOND_URL } from "../../lib/links.ts";

const steps = [
  ["Find your plugin", "Search for it below or on the browse page. Every plugin's page links to its developer checklist."],
  ["Work through the checklist", "Each item names the finding that holds the grade back, with the file and line it came from."],
  ["Release, and we check again", "A new release is checked with the same rules. Moving up a rung shows in the public grade log."],
  ["Disagree? Respond", "Respond on GitHub from an account that maintains the repository. Your words are published next to the card, with our reply."],
];
---

<Base title="For developers · Zotero Plugins Atlas" description="How Zotero plugin developers can see what holds their plugin's grade back, respond to a card, and add the README badge.">
  <SiteHeader active="dev" />
  <div class="wrap">
    <h1>For developers</h1>
    <p class="lead">
      Every plugin gets a checklist for the next rung, not just a verdict. It's public, it points to the exact lines, and it's the same rules for everyone.
    </p>
    <form class="find" action="/browse" method="get" role="search">
      <label class="visually-hidden" for="dev-q">Your plugin's name</label>
      <input id="dev-q" name="q" type="search" placeholder="Your plugin's name or repository" />
      <button class="btn btn-dark">Find it</button>
    </form>
    <ol class="steps">
      {
        steps.map(([t, d], i) => (
          <li>
            <span class="n">{i + 1}</span>
            <span class="sb">
              <strong>{t}</strong>
              <span>{d}</span>
            </span>
          </li>
        ))
      }
    </ol>
    <section id="badge" class="box">
      <strong>The README badge</strong>
      <span class="muted">Shows your plugin's current grade and links to its page. It updates itself when the grade changes.</span>
      <GradeTag grade="A+" variant="readme" />
      <code>[![Plugins Atlas grade]({SITE}/badge/&lt;your-plugin&gt;.svg)]({SITE}/p/&lt;your-plugin&gt;)</code>
      <span class="muted small">Your plugin's checklist page has the snippet with its exact address.</span>
    </section>
    <p class="muted small">Signing in with GitHub, a private preview of each new release's grade and live-test requests are planned. Until then, <a href={RESPOND_URL}>respond on GitHub</a>.</p>
  </div>
  <SiteFooter />
</Base>

<style>
  .wrap {
    max-width: 820px;
    margin: 0 auto;
    padding: 44px var(--gutter) 64px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  h1 {
    margin: 0;
    font-size: 48px;
    line-height: 1.05;
    letter-spacing: -0.035em;
    font-weight: 760;
  }
  .lead {
    margin: 0;
    font-size: 19px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .find {
    display: flex;
    gap: 10px;
  }
  .find input {
    flex: 1;
    min-width: 0;
    min-height: 48px;
    padding: 0 16px;
    border-radius: 12px;
    border: 1.5px solid var(--ink);
    background: var(--surface);
    color: var(--ink);
    font: 17px var(--font-sans);
  }
  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .steps li {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 12px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
  }
  .n {
    font: 700 14px/1.5 var(--font-mono);
    color: var(--accent-fg);
  }
  .sb {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .sb strong {
    font-size: 17px;
  }
  .sb span {
    color: var(--ink-2);
  }
  .box {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }
  .box strong {
    font-size: 18px;
  }
  code {
    align-self: stretch;
    font: 500 12.5px/1.5 var(--font-mono);
    padding: 10px;
    border-radius: 8px;
    background: var(--code-bg);
    border: 1px solid var(--line);
    overflow-wrap: anywhere;
  }
  .muted {
    color: var(--ink-2);
  }
  .small {
    font-size: 14px;
  }
  p {
    margin: 0;
  }
  @media (max-width: 720px) {
    h1 {
      font-size: 36px;
    }
  }
</style>
