---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Base from "../layouts/Base.astro";
---

<Base title="Page not found · Zotero Plugins Atlas" description="There's no page at this address.">
  <SiteHeader search />
  <main class="page">
    <h1>Page not found</h1>
    <p>There's no page at this address. The plugin may have been renamed or removed from the directory.</p>
    <p><a href="/browse">Browse all plugins</a> or <a href="/">go to the home page</a>. Missing a plugin? <a href="/submit">Submit it</a>.</p>
  </main>
  <SiteFooter />
</Base>

<style>
  .page { max-width: 720px; margin: 0 auto; padding: 64px var(--gutter); display: flex; flex-direction: column; gap: 12px; }
  h1 { margin: 0; font-size: clamp(28px, 4vw, 36px); }
  p { margin: 0; line-height: 1.6; }
</style>
