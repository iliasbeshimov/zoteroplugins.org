---
/** One page per add-on ID that two or more plugins share: why it happens, what it means, and every plugin with it. */
import SameIdRow from "../../components/SameIdRow.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import Base from "../../layouts/Base.astro";
import { type Plugin, type SameIdGroup, sameIdGroups, sameIdText } from "../../lib/atlas.ts";

export function getStaticPaths() {
  return [...sameIdGroups().values()].map((g) => ({ params: { id: g.path }, props: { g } }));
}

const { g } = Astro.props as { g: SameIdGroup };
const t = sameIdText(g);
const [top, ...rest] = g.plugins;
const shown = rest.filter((p) => !p.hidden);
const hidden = rest.filter((p) => p.hidden);
const how = (p: Plugin) => {
  const bits: string[] = [];
  if (g.cause === "copies") bits.push(p.forkOf?.slug === top.slug ? "Fork" : "Copy");
  if (p.hiddenReason === "legacy") bits.push("for an older Zotero");
  if (p.hiddenReason === "no-release") bits.push("no release to install");
  return bits.join(", ");
};
const copies = g.cause === "copies";
---

<Base title={`${t.heading} · Zotero Plugins Atlas`} description={`${t.heading}: ${g.id}. Why plugins share an ID and what it means when you install one.`}>
  <SiteHeader />
  <main class="page">
    <a href={`/p/${top.slug}`} class="back">← {top.name}</a>
    <h1>{t.heading}</h1>
    <p class="idline">Their ID: <code>{g.id}</code></p>

    <div class="explain">
      <section>
        <h2>Why does this happen?</h2>
        <p>{t.tag} {t.longWhy}</p>
      </section>
      <section>
        <h2>What it means for you</h2>
        <ul>
          <li>You can only have one of these installed at a time.</li>
          <li>Installing one replaces whichever of them you already have.</li>
          {copies && <li>Many share a name, so check which one a file comes from before you install it.</li>}
          {!copies && <li>The one you install may do something completely different from the one it replaces.</li>}
        </ul>
      </section>
    </div>

    <section class="list" aria-label="Plugins with this ID">
      <div class="head" aria-hidden="true"><span>Plugin</span><span>Our rating</span><span>Downloads</span><span>Last release</span></div>
      <h3>The most used</h3>
      <SameIdRow p={top} note={top.hiddenReason === "legacy" ? "for an older Zotero" : ""} />
      {
        shown.length > 0 && (
          <>
            <h3>{copies ? "Copies of it" : "Others"}, shown in the directory ({shown.length})</h3>
            {shown.map((p) => <SameIdRow p={p} note={how(p)} />)}
          </>
        )
      }
      {
        hidden.length > 0 && (
          <details>
            <summary>{copies ? "Copies" : "Others"} we hide by default ({hidden.length})</summary>
            <p class="muted">Forks, versions for an older Zotero and plugins with no release to install. They still have pages and ratings.</p>
            {hidden.map((p) => <SameIdRow p={p} note={how(p)} />)}
          </details>
        )
      }
    </section>
    {copies && <p class="muted small">"Copy" means a plugin with the same ID whose name or repository name matches the most used one; "Fork" means a GitHub fork of it. We don't know what each copy changed; its own page says what its code does.</p>}
  </main>
  <SiteFooter />
</Base>

<style>
  .page { max-width: 1040px; margin: 0 auto; padding: 40px var(--gutter) 64px; display: flex; flex-direction: column; gap: 20px; }
  .back { font-size: 14px; text-decoration: none; }
  h1 { margin: 0; font-size: clamp(28px, 4vw, 36px); line-height: 1.15; }
  .idline { margin: 0; color: var(--ink); opacity: 0.75; }
  code { font-family: var(--font-mono); background: var(--code-bg); padding: 2px 7px; border-radius: 6px; font-size: 0.92em; overflow-wrap: anywhere; }
  .explain { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
  .explain section { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 20px 22px; }
  .explain h2 { margin: 0 0 8px; font-size: 18px; }
  .explain p, .explain ul { margin: 0; line-height: 1.6; }
  .explain ul { padding-left: 20px; display: flex; flex-direction: column; gap: 4px; }
  .list { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 6px 22px 16px; }
  .list h3 { margin: 18px 0 2px; font: 600 11px / 1.2 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.7; }
  .head { display: grid; grid-template-columns: minmax(0, 1fr) 210px 110px 120px; gap: 12px; font-size: 13px; opacity: 0.7; padding: 12px 0 8px; }
  @media (max-width: 720px) { .head { display: none; } }
  details summary { cursor: pointer; margin-top: 18px; font-weight: 600; min-height: 44px; display: flex; align-items: center; color: var(--accent-ink); }
  .muted { opacity: 0.75; margin: 4px 0 8px; }
  .small { font-size: 13px; line-height: 1.5; }
</style>
