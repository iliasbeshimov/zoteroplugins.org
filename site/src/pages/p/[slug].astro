---
import GradeTag from "../../components/GradeTag.astro";
import InstallSheet from "../../components/InstallSheet.astro";
import Ratings from "../../components/Ratings.astro";
import Scorecard from "../../components/Scorecard.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import StatusIcon from "../../components/StatusIcon.astro";
import Tip from "../../components/Tip.astro";
import Base from "../../layouts/Base.astro";
import SameIdRow from "../../components/SameIdRow.astro";
import { allPlugins, alternatives, bySlug, type Plugin, sameIdGroupOf, sameIdText } from "../../lib/atlas.ts";
import { REVIEWS_OPEN, ratingsOf } from "../../lib/ratings.ts";
import { indexable } from "../../lib/seo.ts";
import { checkedOn, pluginDescription, pluginLd, pluginTitle, verdictSentence } from "../../lib/meta.ts";
import { JOB_BY_SLUG } from "@atlas/schema";
import { REPORT_URL, RESPOND_URL } from "../../lib/links.ts";
import { similarFloor, similarPlugins } from "../../lib/similar.ts";

export function getStaticPaths() {
  return allPlugins().map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: Plugin };
const all = bySlug();
const similar = similarPlugins(p);
const sid = sameIdGroupOf(p);
const sidText = sid ? sameIdText(sid, p) : null;
const sidTop = sid ? sid.plugins.filter((x) => x.slug !== p.slug && !x.hidden).slice(0, 3) : [];
const better = alternatives(p, 3, p.grade);
const data = p.areas.find((a) => a.key === "data")!;
const job0 = p.jobs[0] ? JOB_BY_SLUG[p.jobs[0]] : null;
const blocked = !!p.banner;
const canInstall = !!p.installUrl;
const installLabel = blocked
  ? "Blocked by Zotero"
  : p.retired
    ? "Retired by its developer"
    : p.removed
      ? "Removed from GitHub"
      : !canInstall
        ? "No installable release"
        : `Install v${p.version}`;
const installNote = canInstall
  ? `Downloads a .xpi file (${p.size}). In Zotero, open Tools → Plugins and install it from the file.`
  : p.retired
    ? "Its developer has retired it, so we don't offer it for install. The source stays linked for reference."
    : p.removed
      ? "Its GitHub repository is gone, so there's nothing left to install."
      : "There's no release file current Zotero can install. The source stays linked for reference.";
// A plugin whose GitHub repository is gone: when we found out, what we last checked, and what
// that means for people who have it.
const removedText = p.removed
  ? [
      `Its repository was gone when we checked on ${p.removed.since}.`,
      p.version
        ? `The last version we checked was ${p.version}, released ${p.released}${p.grade === "–" ? "" : `, graded ${p.grade}`}.`
        : "",
      p.removed.updatesStopped
        ? "We no longer offer it for install, and its updates came from that repository, so they've stopped too."
        : "We no longer offer it for install.",
    ]
      .filter(Boolean)
      .join(" ")
  : "";
const alt = p.retired?.alternative;
const altHref = alt ? (alt.slug && all[alt.slug] ? `/p/${alt.slug}` : alt.url) : null;
const RESPONSE_STATUS: Record<string, string> = {
  open: "We're checking",
  corrected: "We corrected our checks",
  fixed: "Fixed by the developer",
  "finding-stands": "Our finding stands",
  noted: "Noted",
};
const RESPONSE_ABOUT: Record<string, string> = {
  "source-transparency": "source transparency",
  "data-sharing": "data sharing",
  capabilities: "capabilities",
  compatibility: "compatibility",
  updates: "updates",
  other: "the listing",
};
const paras = (t: string) => t.split(/\n\s*\n/).map((x) => x.trim()).filter(Boolean);
const stats = [
  ["Stars", p.stars, "People who starred the repository on GitHub: a rough measure of interest."],
  ["Downloads", p.downloads, "All-time downloads of its release files from GitHub. Installs from elsewhere aren't counted."],
  ["Contributors", p.contributors, "People who have committed code to the repository."],
  ["Licence", p.license, "The licence the code is published under, as GitHub reports it."],
];
const forkSlug = p.forkOf?.slug && all[p.forkOf.slug] ? p.forkOf.slug : null;
const crumbs: [string, string][] = [
  ["Home", "/"],
  ["Plugins", "/browse"],
  ...(job0 ? ([[job0.title, `/c/${job0.slug}`]] as [string, string][]) : []),
  [p.name, `/p/${p.slug}`],
];
const openAreas = p.grade === "B" || p.grade === "C" ? p.areas.filter((a) => a.level === "medium" || a.level === "high").map((a) => a.key) : [];
---

<Base title={pluginTitle(p)} description={pluginDescription(p)} noindex={!indexable(p)} jsonld={indexable(p) ? pluginLd(p, crumbs) : undefined}>
  <SiteHeader search />
  {
    p.banner && (
      <div role="alert" class="banner">
        <span class="bi">
          <StatusIcon kind="serious" size={20} color="var(--ser-on)" inner="var(--ser-solid)" />
        </span>
        <span>
          <strong>On Zotero's official blocklist.</strong> {p.banner}
        </span>
      </div>
    )
  }
  {
    p.retired && (
      <div role="note" class="banner retired">
        <span class="bi">
          <StatusIcon kind="info" size={20} color="var(--rev-fg)" />
        </span>
        <span>
          <strong>Retired by its developer.</strong> {p.retired.reason}{" "}
          {alt && altHref && (
            <>
              They point to <a href={altHref}>{alt.name}</a> instead.{" "}
            </>
          )}
          <a href={p.retired.url}>Their note</a>, {p.retired.date}.
        </span>
      </div>
    )
  }

  {
    p.removed && (
      <div role="note" class="banner retired">
        <span class="bi">
          <StatusIcon kind="info" size={20} color="var(--rev-fg)" />
        </span>
        <span>
          <strong>Removed from GitHub.</strong> {removedText}
        </span>
      </div>
    )
  }

  <div class="hero">
    <div class="intro">
      <span class="crumb"><a href="/browse">Plugins</a>{job0 && <> / <a href={`/c/${job0.slug}`}>{job0.title}</a></>}</span>
      <h1>{p.name}</h1>
      <span class="by">by {p.author} · <a href={p.repoUrl}>github.com/{p.repo}</a></span>
      <p class="lead">{p.oneLiner}</p>
      <p class="verdict">
        {verdictSentence(p)}{" "}
        {p.legacy && (
          <>
            <a href={`/zotero-6-plugins#${p.slug}`}>What to use instead</a>.{" "}
          </>
        )}
        <span class="checked">Last checked {checkedOn(p)}.</span>
      </p>
      {
        p.jobs.length > 0 && (
          <div class="cats">
            {p.jobs.map((j) => (
              <a href={`/c/${j}`}>{JOB_BY_SLUG[j].title}</a>
            ))}
          </div>
        )
      }
      <div class="actions">
        <button type="button" class="btn btn-primary install" disabled={!canInstall} data-open-install={canInstall ? "" : undefined}>{installLabel}</button>
        <a href={p.repoUrl} class="btn">View source</a>
      </div>
      <span class="note">{installNote}</span>
      <dl class="stats">
        {
          stats.map(([k, v, tip]) => (
            <div>
              <dt>
                <Tip text={tip} class="tip-start">{k}</Tip>
              </dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="card" id="scorecard">
      <Scorecard p={p} open={openAreas} />
    </div>
  </div>

  <div class="body">
    <main>
      <section>
        {p.description ? <div class="sh"><h2>What it does</h2><span class="mono-sm">Written by AI from the README</span></div> : <h2>What it does</h2>}
        {
          p.description ? (
            p.description.map((d) => <p class="prose">{d}</p>)
          ) : (
            <div class="dashed-note">
              <strong style="color:var(--ink)">Description coming soon.</strong> We haven't written a summary yet. {p.descSoon ? "" : "The line above is the developer's own description; "}the developer's README is linked above.
            </div>
          )
        }
      </section>

      <section>
        <div class="sh"><h2>What you'll need</h2><span class="mono-sm">Detected automatically</span></div>
        {
          p.needs.length ? (
            <ul class="needs">
              {p.needs.map((n) => (
                <li>
                  <span aria-hidden="true" class="dot" />
                  <span class="nt">
                    <strong>{n.t}</strong>
                    {n.sub && <span>{n.sub}</span>}
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="muted">We haven't detected any setup requirements. That isn't the same as none: check the developer's README.</p>
          )
        }
      </section>

      <section>
        <h2>Where your data goes</h2>
        <p class="prose"><strong>We found: {data.value.charAt(0).toLowerCase() + data.value.slice(1)}.</strong> {data.sub}</p>
        {
          data.groups.map((g) => (
            <div class="dg">
              {g.name && <span class="eyebrow">{g.name}</span>}
              <div class="chips">
                {g.items.map((c) => (
                  <span class:list={["chip", c.tone && `t-${c.tone}`, { mono: c.mono }]}>
                    {c.t}
                    {c.note && <span class="cn">{c.note}</span>}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
        {
          data.evidence.length > 0 && (
            <div class="evs">
              <span class="eyebrow">Evidence · file and line</span>
              {data.evidence.map((e) => (
                <div class="ev">
                  <div class="evh">
                    <strong>{e.what}</strong>
                    <span>{e.loc}</span>
                  </div>
                  <pre>{e.code}</pre>
                </div>
              ))}
            </div>
          )
        }
      </section>

      {
        similar.shown.length > 0 && (
          <section id="similar">
            <div class="sh"><h2>Other plugins that do this</h2><span class="mono-sm">Matched on what they do</span></div>
            <p class="muted">For the same job, work with Zotero {p.currentMajor} and graded {similarFloor(p)} or better. Closest match first.</p>
            <ul class="sim">
              {similar.shown.map((s) => (
                <li>
                  <GradeTag grade={s.p.grade} size="sm" />
                  <div class="sim-body">
                    <a href={`/p/${s.p.slug}`} class="sim-name">{s.p.name}</a>
                    <p class="sim-does">{s.p.oneLiner}</p>
                    <span class="sim-meta">
                      {[s.matched && `Matches “${s.matched}”`, `${s.p.downloads} downloads`, s.p.maint, `Zotero ${s.p.worksRange}`].filter(Boolean).join(" · ")}
                    </span>
                  </div>
                  {s.labels.length > 0 && (
                    <span class="sim-labels">
                      {s.labels.map((l) => <span class="sim-label">{l}</span>)}
                    </span>
                  )}
                </li>
              ))}
            </ul>
            <div class="sim-foot">
              <a href={`/compare?p=${[p, ...similar.shown.map((s) => s.p)].map((x) => x.slug).join(",")}`} class="btn">
                Compare all {similar.shown.length + 1} side by side
              </a>
              <details class="sim-how">
                <summary>How we pick these</summary>
                <p>By how closely what they do matches this plugin, using descriptions and the phrases people search with. Copies and forks of this plugin are listed under Forks and copies instead. No plugin pays to appear here.</p>
              </details>
            </div>
          </section>
        )
      }

      <section>
        <h2>Forks and copies</h2>
        {p.forkOf && <p>Fork of {forkSlug ? <a href={`/p/${forkSlug}`} style="font-weight:650">{p.forkOf.name}</a> : <strong>{p.forkOf.name}</strong>}.</p>}
        {
          sid && sidText && (
            <details class="sameid">
              <summary>
                <span class="si">
                  <StatusIcon kind="review" size={18} />
                </span>
                <span>
                  <strong>{sidText.heading}.</strong> {sidText.tag} {sidText.why}
                  <span class="more">Show what this means</span>
                </span>
              </summary>
              <div class="sid-body">
                <ul class="sid-points">
                  <li><strong>You can only have one.</strong> Zotero sees them as the same plugin.</li>
                  <li><strong>Installing another replaces it.</strong> If you install one of the others, it takes this one's place.</li>
                  <li>{sid.cause === "copies" ? <><strong>Check what you install.</strong> Several share this plugin's name, so make sure the file comes from the one you meant.</> : <><strong>They do different things.</strong> The one you install may have nothing to do with the one it replaces.</>}</li>
                </ul>
                {sid.plugins.filter((x) => !x.hidden).length > 0 && (
                  <div>
                    <SameIdRow p={p} current />
                    {sidTop.map((x) => <SameIdRow p={x} note={sid.cause === "copies" ? (x.forkOf?.slug === sid.plugins[0].slug ? "Fork" : x.slug === sid.plugins[0].slug ? "The most used" : "Copy") : ""} />)}
                  </div>
                )}
                <a href={`/id/${sid.path}`} class="sid-all">See all {sid.plugins.length} and how they differ →</a>
              </div>
            </details>
          )
        }
        <p class="muted">{p.forksCount ? `${p.forksCount} listed fork${p.forksCount > 1 ? "s" : ""}.` : "No forks listed."}</p>
      </section>

      <section>
        <h2>{p.responses.length > 1 ? "The developer's responses" : "The developer's response"}</h2>
        {
          p.responses.length ? (
            <>
              {p.responses.map((r) => (
                <figure class="resp">
                  <span class="rstatus mono-sm" data-status={r.status}>
                    {RESPONSE_STATUS[r.status] ?? r.status}
                  </span>
                  <blockquote>
                    {paras(r.text).map((t) => (
                      <p>{t}</p>
                    ))}
                  </blockquote>
                  <figcaption class="mono-sm">
                    {r.who} · <a href={r.url}>{r.date}</a> · about {RESPONSE_ABOUT[r.about] ?? r.about}
                    {r.version && <> in v{r.version}</>}
                  </figcaption>
                  {r.reply && (
                    <div class="reply">
                      <strong>Our reply</strong>
                      {paras(r.reply).map((t) => (
                        <p>{t}</p>
                      ))}
                    </div>
                  )}
                </figure>
              ))}
              <a href={RESPOND_URL} class="small">Respond as the developer</a>
            </>
          ) : (
            <div class="nodev">
              <span class="muted" style="max-width:48ch">
                <strong style="color:var(--ink)">The developer hasn't responded.</strong> Developers can reply here, and their reply sits next to our findings.
              </span>
              <a href={RESPOND_URL} class="btn">I'm the developer</a>
            </div>
          )
        }
      </section>
      {
        (REVIEWS_OPEN || ratingsOf(p.slug)) && (
          <section id="reviews">
            <h2>Ratings and reviews</h2>
            <Ratings slug={p.slug} name={p.name} version={p.version ?? null} />
          </section>
        )
      }
    </main>

    <aside>
      <section>
        <h2 class="h3">Compatibility</h2>
        <div class="compat">
          {
            p.compat.map((c) => (
              <div>
                <span class="cv">
                  Zotero {c.v}
                  {c.cur && <Tip text="The newest stable Zotero release." class="curtag plain">CURRENT</Tip>}
                </span>
                <span style={`color:${c.ok ? "var(--few-fg)" : c.ok === null || c.v.includes("beta") ? "var(--ink-2)" : "var(--rev-fg)"}`}>
                  {c.ok ? "✓ Works" : c.ok === null ? "? Not known" : "✗ Doesn't work"}
                </span>
              </div>
            ))
          }
        </div>
        <span class="muted small">{p.autoText}</span>
      </section>
      <section>
        <h2 class="h3">Languages</h2>
        <div class="langs">
          <span class="muted">Documentation</span><span><span class:list={{ hl: p.chineseDocs }}>{p.docs}</span></span>
          <span class="muted">Interface</span><span>{p.ui}</span>
        </div>
      </section>
      <section>
        <h2 class="h3">Version history</h2>
        {
          p.version ? (
            <ol class="versions">
              <li>
                <span class="vg">
                  <GradeTag grade={p.grade} size="xs" />
                </span>
                <span class="vl">
                  <span>v{p.version}</span>
                  <span class="muted">{p.released}</span>
                </span>
                <span style={`color:var(--${p.gradeTone}-fg);font-size:13.5px;font-weight:600`}>{p.gradeLong}</span>
              </li>
            </ol>
          ) : (
            <p class="muted">No release file.</p>
          )
        }
        <span class="muted small">We grade the latest release. <a href={p.releasesUrl}>All releases on GitHub</a></span>
      </section>
      <section class="report">
        <h2 class="h3">Report a problem</h2>
        <p class="muted">Something wrong on this page, or something we missed in the code? Tell us. We read every report.</p>
        <a href={REPORT_URL} class="btn btn-dark">Report a problem</a>
        <a href={`/developers/${p.slug}`} class="small">Developer checklist for this plugin</a>
      </section>
    </aside>
  </div>

  {canInstall && <InstallSheet p={p} better={better} />}
  <SiteFooter />
</Base>

<style>
  .banner {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 14px var(--gutter);
    background: var(--ser-solid);
    color: var(--ser-on);
    font-size: 15px;
    line-height: 1.45;
  }
  .banner.retired {
    background: var(--rev-bg);
    color: var(--ink);
    border-bottom: 1px solid var(--rev-line);
  }
  .banner.retired a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .bi {
    flex: none;
    padding-top: 1px;
    display: flex;
  }
  .hero {
    display: flex;
    flex-wrap: wrap;
    gap: 36px 44px;
    padding: 44px var(--gutter) 24px;
    align-items: flex-start;
    max-width: 1440px;
    margin: 0 auto;
  }
  .intro {
    flex: 1 1 340px;
    min-width: 0;
    max-width: 460px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .crumb {
    font: 500 12.5px/1.3 var(--font-mono);
    color: var(--ink-3);
  }
  .crumb a {
    color: var(--ink-2);
  }
  h1 {
    margin: 0;
    font-size: 54px;
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 760;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .verdict {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }
  .verdict .checked {
    white-space: nowrap;
  }
  .by {
    font: 500 13px/1.4 var(--font-mono);
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }
  .lead {
    margin: 0;
    font-size: 20px;
    line-height: 1.42;
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }
  .cats {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .cats a {
    padding: 4px 11px;
    border-radius: 999px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    color: var(--ink);
    font-size: 13.5px;
    font-weight: 560;
    text-decoration: none;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 4px;
  }
  .install {
    min-height: 48px;
    padding: 0 22px;
    font-size: 16px;
    font-weight: 700;
    box-shadow: var(--shadow-1);
  }
  .install:disabled {
    background: var(--surface-2);
    border-color: var(--line-strong);
    color: var(--ink-2);
    cursor: not-allowed;
    filter: none;
  }
  .actions .btn {
    min-height: 48px;
  }
  .note {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-2);
  }
  /* No overflow clipping here: it would cut off the labels' tooltips. */
  .stats {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .stats div {
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .stats div + div {
    border-left: 1px solid var(--line);
  }
  dt {
    font: 500 11px/1.2 var(--font-mono);
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  dd {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  .card {
    flex: 1.5 1 540px;
    min-width: 0;
    scroll-margin-top: 16px;
  }
  .body {
    display: flex;
    flex-wrap: wrap;
    gap: 48px 56px;
    padding: 40px var(--gutter) 64px;
    align-items: flex-start;
    max-width: 1440px;
    margin: 0 auto;
  }
  main {
    flex: 1.6 1 540px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  aside {
    flex: 1 1 300px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  section {
    border-top: 2px solid var(--ink);
    padding-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  h2 {
    margin: 0;
    font-size: 26px;
    line-height: 1.15;
    letter-spacing: -0.025em;
    font-weight: 720;
  }
  h2.h3 {
    font-size: 20px;
    letter-spacing: -0.02em;
  }
  .sh {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }
  .prose {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    max-width: 66ch;
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }
  p {
    margin: 0;
  }
  .muted {
    color: var(--ink-2);
  }
  .small {
    font-size: 14px;
  }
  .needs {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--line);
  }
  .needs li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 14px 16px;
    background: var(--surface);
  }
  .dot {
    flex: none;
    margin-top: 7px;
    width: 9px;
