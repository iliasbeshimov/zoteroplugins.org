---
/** A submitted plugin whose checks are still running: no grade, no description, no Install button. */
import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import Base from "../../layouts/Base.astro";
import { fmtDate } from "../../lib/atlas.ts";
import { inReview, type SubmissionRecord } from "../../lib/submissions.ts";

export function getStaticPaths() {
  return inReview().map((r) => ({ params: { review: r.slug }, props: { r } }));
}
const { r } = Astro.props as { r: SubmissionRecord };
const url = `https://github.com/${r.repo}`;
---

<Base title={`${r.name ?? r.repo} (in review) · Zotero Plugins Atlas`} description={`${r.name ?? r.repo} was submitted to the atlas and is being checked.`}>
  <SiteHeader search />
  <main class="page">
    <p class="crumb">Plugins / In review</p>
    <h1>{r.name ?? r.repo}</h1>
    <p class="by"><a href={url}>github.com/{r.repo}</a></p>
    <section class="box">
      <span class="tag">In review</span>
      <h2>Not checked yet</h2>
      <p>Someone submitted this plugin on {fmtDate(r.decidedAt)}. We've confirmed it's a Zotero plugin{r.checkedTag ? ` (release ${r.checkedTag})` : ""}, and we're now checking its code. Its grade and description will appear here when the checks finish, usually within half an hour.</p>
      <p>Until then we don't offer its file. You can still find it on <a href={url}>its GitHub page</a>.</p>
    </section>
  </main>
  <SiteFooter />
</Base>

<style>
  .page { max-width: 760px; margin: 0 auto; padding: 40px var(--gutter) 64px; display: flex; flex-direction: column; gap: 12px; }
  .crumb { margin: 0; font: 500 13px/1.4 var(--font-mono); color: var(--ink-3); }
  h1 { margin: 0; font-size: clamp(28px, 4vw, 40px); line-height: 1.05; letter-spacing: -0.035em; font-weight: 780; overflow-wrap: anywhere; }
  .by { margin: 0; font-family: var(--font-mono); font-size: 14px; overflow-wrap: anywhere; }
  .box { margin-top: 16px; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 22px 24px; display: flex; flex-direction: column; gap: 10px; }
  .box h2 { margin: 0; font-size: 20px; font-weight: 720; }
  .box p { margin: 0; line-height: 1.6; }
  .tag { align-self: flex-start; font: 600 12px/1 var(--font-mono); padding: 6px 10px; border-radius: 6px; border: 1px dashed var(--line-strong); color: var(--ink-2); }
</style>
