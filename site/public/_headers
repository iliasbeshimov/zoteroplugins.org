# Cloudflare Pages response headers for static files (Pages Functions under /api set their own).
# Pages already adds X-Content-Type-Options: nosniff and Referrer-Policy: strict-origin-when-cross-origin.
# No other site may frame these pages; the Zotero Atlas plugin opens them in the browser.
/*
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

# Data files and badges are for programs, not search results.
/api/*
  X-Robots-Tag: noindex
/badge/*
  X-Robots-Tag: noindex
/p/*.json
  X-Robots-Tag: noindex
/search.json
  X-Robots-Tag: noindex
# The plugin packs' PDFs repeat their pages, which are the ones to find in search.
/for/*.pdf
  X-Robots-Tag: noindex

# Self-hosted fonts, kept by browsers for a year: give a replaced file a new name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
