# Cloudflare Pages response headers for static files (Pages Functions under /api set their own).
# Pages already adds X-Content-Type-Options: nosniff and Referrer-Policy: strict-origin-when-cross-origin.
# No other site may frame these pages; the Zotero Atlas plugin opens them in the browser.
/*
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
